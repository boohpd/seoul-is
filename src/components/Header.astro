---
<header class="site-header" id="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      seoul<span class="gold-dot">.</span>is
    </a>
    <nav class="nav-links" id="nav-links">
      <a href="/">Home</a>
      <a href="/live"><span class="live-dot" style="display:inline-block;width:7px;height:7px;"></span> Live</a>
      <a href="/courses">Courses</a>
      <a href="/essentials">Essentials</a>
      <a href="/events">Events</a>
      <a href="/spot/seoulis-cafe" class="nav-cafe">CAFÉ</a>
    </nav>
    <div class="lang-pills">
      <button class="lang-pill active" data-lang="EN">🇺🇸 EN</button>
      <button class="lang-pill" data-lang="KO">🇰🇷 KO</button>
      <button class="lang-pill" data-lang="JA">🇯🇵 JA</button>
      <button class="lang-pill" data-lang="ZH">🇨🇳 ZH</button>
      <button class="lang-pill" data-lang="TH">🇹🇭 TH</button>
      <button class="lang-pill" data-lang="VI">🇻🇳 VI</button>
      <button class="lang-pill" data-lang="ID">🇮🇩 ID</button>
    </div>
    <button class="hamburger" id="hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: rgba(13,27,42,0.85);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
}
.header-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0.75rem 1.5rem;
  display: flex;
  align-items: center;
  gap: 2rem;
}
.logo {
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 900;
  letter-spacing: -0.02em;
  color: var(--white);
  white-space: nowrap;
}
.gold-dot { color: var(--gold); }
.nav-links {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex: 1;
}
.nav-links a {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--gray);
  transition: color 0.2s;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 4px;
}
.nav-links a:hover { color: var(--white); }
.nav-cafe {
  background: var(--gold);
  color: #000 !important;
  padding: 4px 14px;
  border-radius: 999px;
  font-size: 0.8rem !important;
}
.lang-pills {
  display: flex;
  gap: 4px;
  flex-shrink: 0;
}
.lang-pill {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--gray);
  font-size: 0.72rem;
  padding: 3px 8px;
  border-radius: 999px;
  transition: all 0.2s;
}
.lang-pill.active, .lang-pill:hover {
  background: var(--gold);
  color: #000;
  border-color: var(--gold);
}
.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  padding: 4px;
  margin-left: auto;
}
.hamburger span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--white);
  border-radius: 2px;
  transition: all 0.3s;
}
@media (max-width: 768px) {
  .nav-links {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg);
    flex-direction: column;
    padding: 1rem 1.5rem;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .nav-links.open { display: flex; }
  .hamburger { display: flex; }
  .lang-pills { display: none; }
}
</style>

<script src="/i18n.js"></script>
<script>
const ham = document.getElementById('hamburger');
const nav = document.getElementById('nav-links');
ham?.addEventListener('click', () => nav?.classList.toggle('open'));

const T = {
  EN:{sec_latest:'Latest from Seoul',sec_weather:"Today's Weather & What to Wear",sec_events:'Upcoming Events',sec_essentials:'Korea Essentials for First-Timers',nav_home:'Home',nav_articles:'Articles',nav_weather:'Weather',nav_events:'Events',hero_title:'Seoul Is Where You Belong',hero_sub:'Your insider guide to K-culture, travel & local life'},
  KO:{sec_latest:'서울 최신 소식',sec_weather:'오늘의 날씨 & 스타일',sec_events:'다가오는 이벤트',sec_essentials:'처음 오는 분들을 위한 필수 정보',nav_home:'홈',nav_articles:'기사',nav_weather:'날씨',nav_events:'이벤트',hero_title:'서울이 당신의 집입니다',hero_sub:'K-컬처, 여행, 현지 생활의 인사이더 가이드'},
  JA:{sec_latest:'ソウル最新情報',sec_weather:'今日の天気とスタイル',sec_events:'イベント情報',sec_essentials:'初めての方への必須情報',nav_home:'ホーム',nav_articles:'記事',nav_weather:'天気',nav_events:'イベント',hero_title:'ソウルはあなたの居場所',hero_sub:'K-カルチャー、旅行、現地生活のインサイダーガイド'},
  ZH:{sec_latest:'首尔最新资讯',sec_weather:'今日天气与穿搭',sec_events:'近期活动',sec_essentials:'初次到访必备信息',nav_home:'首页',nav_articles:'文章',nav_weather:'天气',nav_events:'活动',hero_title:'首尔是你的归属',hero_sub:'K-文化、旅行与本地生活的内部指南'},
  VI:{sec_latest:'Tin tức mới nhất từ Seoul',sec_weather:'Thời tiết hôm nay',sec_events:'Sự kiện sắp tới',sec_essentials:'Thông tin cần thiết',nav_home:'Trang chủ',nav_articles:'Bài viết',nav_weather:'Thời tiết',nav_events:'Sự kiện',hero_title:'Seoul là nơi bạn thuộc về',hero_sub:'Hướng dẫn K-culture, du lịch và cuộc sống địa phương'},
  TH:{sec_latest:'ข่าวล่าสุดจากโซล',sec_weather:'สภาพอากาศวันนี้',sec_events:'กิจกรรมที่กำลังจะมาถึง',sec_essentials:'ข้อมูลจำเป็น',nav_home:'หน้าแรก',nav_articles:'บทความ',nav_weather:'สภาพอากาศ',nav_events:'กิจกรรม',hero_title:'โซลคือที่ที่คุณเป็นของ',hero_sub:'คู่มือ K-culture การเดินทาง และชีวิตในท้องถิ่น'},
  ID:{sec_latest:'Terbaru dari Seoul',sec_weather:'Cuaca Hari Ini',sec_events:'Acara Mendatang',sec_essentials:'Info Penting untuk Pertama Kali',nav_home:'Beranda',nav_articles:'Artikel',nav_weather:'Cuaca',nav_events:'Acara',hero_title:'Seoul Adalah Tempat Anda',hero_sub:'Panduan insider K-culture, perjalanan & kehidupan lokal'},
};

function applyLang(lang) {
  const t = T[lang] || T.EN;
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const k = el.dataset.i18n;
    if (t[k]) el.textContent = t[k];
  });
  // hero
  const h1 = document.querySelector('.hero-headline');
  if (h1 && t.hero_title) h1.innerHTML = t.hero_title.replace(' ', '<br>');
  document.documentElement.lang = lang.toLowerCase();
  showToast('✓ ' + lang);
}

// Lang handled by /i18n.js
</script>
