---
---
<header class="site-header" id="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      seoul<span class="gold-dot">.</span>is
    </a>
    <nav class="nav-links" id="nav-links">
      <a href="/">Home</a>
      <a href="/live"><span class="live-dot" style="display:inline-block;width:7px;height:7px;"></span> Live</a>
      <a href="/courses">Courses</a>
      <a href="/essentials">Essentials</a>
      <a href="/events">Events</a>
      <a href="/spot/seoulis-cafe" class="nav-cafe">CAFÉ</a>
    </nav>
    <div class="lang-pills">
      <button class="lang-pill active" data-lang="EN">🇺🇸 EN</button>
      <button class="lang-pill" data-lang="KO">🇰🇷</button>
      <button class="lang-pill" data-lang="JA">🇯🇵</button>
      <button class="lang-pill" data-lang="ZH">🇨🇳</button>
    </div>
    <button class="hamburger" id="hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: rgba(13,27,42,0.85);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
}
.header-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0.75rem 1.5rem;
  display: flex;
  align-items: center;
  gap: 2rem;
}
.logo {
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 900;
  letter-spacing: -0.02em;
  color: var(--white);
  white-space: nowrap;
}
.gold-dot { color: var(--gold); }
.nav-links {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex: 1;
}
.nav-links a {
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--gray);
  transition: color 0.2s;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 4px;
}
.nav-links a:hover { color: var(--white); }
.nav-cafe {
  background: var(--gold);
  color: #000 !important;
  padding: 4px 14px;
  border-radius: 999px;
  font-size: 0.8rem !important;
}
.lang-pills {
  display: flex;
  gap: 4px;
  flex-shrink: 0;
}
.lang-pill {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--gray);
  font-size: 0.72rem;
  padding: 3px 8px;
  border-radius: 999px;
  transition: all 0.2s;
}
.lang-pill.active, .lang-pill:hover {
  background: var(--gold);
  color: #000;
  border-color: var(--gold);
}
.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  padding: 4px;
  margin-left: auto;
}
.hamburger span {
  display: block;
  width: 22px;
  height: 2px;
  background: var(--white);
  border-radius: 2px;
  transition: all 0.3s;
}
@media (max-width: 768px) {
  .nav-links {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg);
    flex-direction: column;
    padding: 1rem 1.5rem;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .nav-links.open { display: flex; }
  .hamburger { display: flex; }
  .lang-pills { display: none; }
}
</style>

<script>
const ham = document.getElementById('hamburger');
const nav = document.getElementById('nav-links');
ham?.addEventListener('click', () => nav?.classList.toggle('open'));

document.querySelectorAll('.lang-pill').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.lang-pill').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const lang = btn.dataset.lang;
    if (lang !== 'EN') showToast(`Coming soon in ${lang}!`);
  });
});

function showToast(msg) {
  let t = document.getElementById('lang-toast');
  if (!t) { t = document.createElement('div'); t.id = 'lang-toast'; document.body.appendChild(t); }
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2500);
}
</script>
