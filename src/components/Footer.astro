---
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="logo">seoul<span class="gold-dot">.</span>is</a>
      <p class="tagline">Your ultimate guide to Seoul & Korean culture</p>
      <div class="socials">
        <a href="https://instagram.com" target="_blank" rel="noopener">📸 Instagram</a>
        <a href="https://twitter.com" target="_blank" rel="noopener">🐦 Twitter</a>
        <a href="https://t.me" target="_blank" rel="noopener">✈️ Telegram</a>
      </div>
    </div>
    <div class="footer-flags">
      <span title="English">🇺🇸</span>
      <span title="Korean">🇰🇷</span>
      <span title="Japanese">🇯🇵</span>
      <span title="Chinese">🇨🇳</span>
      <span title="Vietnamese">🇻🇳</span>
      <span title="Thai">🇹🇭</span>
      <span title="Indonesian">🇮🇩</span>
    </div>
    <p class="copyright">© 2026 SEOULIS · Seoul, Korea</p>
  </div>
</footer>

<style>
.site-footer {
  border-top: 1px solid var(--border);
  padding: 2.5rem 1.5rem;
  margin-top: 4rem;
}
.footer-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
  text-align: center;
}
.logo {
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 900;
  color: var(--white);
}
.gold-dot { color: var(--gold); }
.tagline { color: var(--gray); font-size: 0.85rem; margin-top: 0.25rem; }
.socials { display: flex; gap: 1.25rem; margin-top: 0.75rem; }
.socials a { color: var(--gray); font-size: 0.85rem; transition: color 0.2s; }
.socials a:hover { color: var(--gold); }
.footer-flags { font-size: 1.4rem; letter-spacing: 0.15em; }
.copyright { color: var(--gray); font-size: 0.8rem; }
</style>
