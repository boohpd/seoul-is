---
// Bottom navigation for mobile — app-like experience
---
<nav class="bottom-nav" id="bottom-nav">
  <a href="/" class="bn-item" data-page="home">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
      <polyline points="9 22 9 12 15 12 15 22"/>
    </svg>
    <span>Home</span>
  </a>
  <a href="/explore" class="bn-item" data-page="explore">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"/>
      <line x1="21" y1="21" x2="16.65" y2="16.65"/>
    </svg>
    <span>Explore</span>
  </a>
  <a href="/guide" class="bn-item" data-page="guide">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
      <polyline points="14 2 14 8 20 8"/>
    </svg>
    <span>Guides</span>
  </a>
  <a href="/flights" class="bn-item" data-page="flights">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
    </svg>
    <span>Flights</span>
  </a>
  <a href="/stays" class="bn-item" data-page="stays">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
      <line x1="7" y1="7" x2="7.01" y2="7"/>
    </svg>
    <span>Stays</span>
  </a>
</nav>

<!-- Spacer so content isn't hidden behind bottom nav on mobile -->
<div class="bottom-nav-spacer"></div>

<style>
.bottom-nav {
  display: none;
}

@media (max-width: 767px) {
  .bottom-nav {
    display: flex;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 8px 0 max(8px, env(safe-area-inset-bottom));
    justify-content: space-around;
  }

  .bottom-nav-spacer {
    height: 64px;
  }

  .bn-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 4px 12px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
    flex: 1;
  }

  .bn-item svg {
    width: 22px;
    height: 22px;
    stroke: currentColor;
  }

  .bn-item span {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2px;
  }

  .bn-item.active,
  .bn-item:hover {
    color: var(--primary);
  }
}
</style>

<script>
  // Mark active tab based on current path
  const path = window.location.pathname;
  document.querySelectorAll('.bn-item').forEach(item => {
    const page = item.getAttribute('data-page');
    if (
      (page === 'home' && path === '/') ||
      (page !== 'home' && path.startsWith('/' + page))
    ) {
      item.classList.add('active');
    }
  });
</script>
