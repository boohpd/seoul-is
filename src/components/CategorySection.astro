---
/**
 * CategorySection — Editorial list style
 */

import { CATEGORIES } from '../lib/categories.js';

const { categoryId, items = [] } = Astro.props;
const cat = CATEGORIES[categoryId];
if (!cat || items.length === 0) return;

const displayItems = items.slice(0, 6);
---

<section id={categoryId} class="cat-section">
  <!-- Section header: gold left-border + Playfair heading -->
  <div class="cat-header">
    <div class="cat-header-left">
      <h2 class="cat-name">{cat.name}</h2>
      {cat.desc && <p class="cat-desc">{cat.desc}</p>}
    </div>
    <a href={`/category/${categoryId}`} class="view-all-btn">
      View All →
    </a>
  </div>

  <!-- Editorial list: title + category + date, dividers -->
  <div class="editorial-list">
    {displayItems.map((item, i) => (
      <a href={`/article/${item.slug}`} class="editorial-item">
        <div class="editorial-item-left">
          <span class="editorial-item-num">{String(i + 1).padStart(2, '0')}</span>
          <div class="editorial-item-text">
            <span class="editorial-item-cat">{item.category || cat.name}</span>
            <h3 class="editorial-item-title">{item.title}</h3>
          </div>
        </div>
        <div class="editorial-item-meta">
          {item.date && (
            <span class="editorial-item-date">
              {new Date(item.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
            </span>
          )}
          <span class="editorial-item-arrow">→</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .cat-section {
    scroll-margin-top: 80px;
  }

  /* ─── Section Header ─── */
  .cat-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 32px;
    padding-left: 16px;
    border-left: 2px solid var(--color-gold);
    gap: 16px;
  }

  .cat-header-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cat-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.3px;
    line-height: 1.2;
  }

  .cat-desc {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: rgba(255,255,255,0.3);
    letter-spacing: 0.2px;
  }

  .view-all-btn {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-gold);
    flex-shrink: 0;
    transition: opacity var(--transition-fast);
  }
  .view-all-btn:hover { opacity: 0.65; }

  /* ─── Editorial list ─── */
  .editorial-list {
    display: flex;
    flex-direction: column;
  }

  .editorial-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    text-decoration: none;
    transition: all var(--transition-fast);
  }
  .editorial-item:first-child { border-top: 1px solid rgba(255,255,255,0.06); }
  .editorial-item:hover { padding-left: 8px; }
  .editorial-item:hover .editorial-item-title { color: rgba(255,255,255,0.9); }
  .editorial-item:hover .editorial-item-arrow { color: var(--color-gold); transform: translateX(4px); }

  .editorial-item-left {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    flex: 1;
    min-width: 0;
  }

  .editorial-item-num {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    color: rgba(255,255,255,0.15);
    letter-spacing: 1px;
    flex-shrink: 0;
    padding-top: 2px;
    min-width: 24px;
  }

  .editorial-item-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .editorial-item-cat {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .editorial-item-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(15px, 2vw, 19px);
    font-weight: 600;
    color: rgba(255,255,255,0.75);
    line-height: 1.3;
    transition: color var(--transition-fast);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .editorial-item-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .editorial-item-date {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 400;
    color: rgba(255,255,255,0.2);
    letter-spacing: 0.3px;
    white-space: nowrap;
  }

  .editorial-item-arrow {
    font-size: 14px;
    color: rgba(255,255,255,0.15);
    transition: all var(--transition-fast);
  }
</style>
