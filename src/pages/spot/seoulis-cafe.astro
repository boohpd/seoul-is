---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const gallery = [
  'https://images.unsplash.com/photo-1559925393-8be0ec4767c8?w=500&q=80',
  'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=500&q=80',
  'https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?w=500&q=80',
  'https://images.unsplash.com/photo-1442512595331-e89e73853f31?w=500&q=80',
  'https://images.unsplash.com/photo-1509042239860-f550ce710b93?w=500&q=80',
  'https://images.unsplash.com/photo-1572442388796-11668a67e53d?w=500&q=80',
];

const menu = [
  { name: 'Signature Seoul Latte', desc: 'Double shot espresso, oat milk, gold dust — our story in a cup.', price: '₩8,500' },
  { name: 'K-Matcha', desc: 'Premium Uji matcha, steamed coconut milk, subtle honey.', price: '₩7,500' },
  { name: 'Bingsu Parfait', desc: 'Shaved ice, red bean, mochi, condensed milk — a Seoul classic reimagined.', price: '₩12,000' },
  { name: 'Tteok Affogato', desc: 'Vanilla gelato, espresso shot, rice cake crumble.', price: '₩9,000' },
  { name: 'Hallabong Fizz', desc: 'Jeju tangerine, sparkling water, rosemary. Non-alcoholic.', price: '₩6,500' },
  { name: 'SEOULIS Toast', desc: 'Milk bread, butter, red bean cream, egg — the classic.', price: '₩7,000' },
];
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SEOULIS CAFÉ — Coming 2027, Hongdae Seoul</title>
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <Header />

  <!-- Hero -->
  <section class="cafe-hero">
    <img src="https://images.unsplash.com/photo-1559925393-8be0ec4767c8?w=1400&q=80" alt="SEOULIS Café" />
    <div class="cafe-overlay">
      <p class="cafe-coming">Opening 2027 · Hongdae, Seoul</p>
      <h1 class="display">SEOULIS CAFÉ</h1>
      <p class="cafe-sub">K-culture • Specialty Coffee • Editorial Space</p>
      <a href="#waitlist" class="btn btn-gold" style="margin-top:1.5rem;">Join Waitlist →</a>
    </div>
  </section>

  <!-- About -->
  <section class="section cafe-about">
    <div class="about-grid">
      <div>
        <h2 class="display">Where Seoul's culture<br/>meets your coffee.</h2>
        <p>SEOULIS CAFÉ isn't just a coffee shop — it's a cultural hub. Inspired by the editorial energy of Seongsu, the underground creativity of Hongdae, and the warmth of traditional Korean teahouses.</p>
        <p>We're opening our first location in Hongdae in 2027. Sign up to be the first inside.</p>
      </div>
      <div class="about-stats">
        <div class="stat"><span>2027</span><p>Opening Year</p></div>
        <div class="stat"><span>Hongdae</span><p>Seoul, Korea</p></div>
        <div class="stat"><span>∞</span><p>Vibes</p></div>
      </div>
    </div>
  </section>

  <!-- Menu Preview -->
  <section class="section">
    <h2 class="section-title">☕ Menu <span>Preview</span></h2>
    <div class="menu-grid">
      {menu.map(m => (
        <div class="menu-item">
          <div class="menu-top">
            <h3>{m.name}</h3>
            <span class="menu-price">{m.price}</span>
          </div>
          <p>{m.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Gallery -->
  <section class="section">
    <h2 class="section-title">📸 <span>Gallery</span></h2>
    <div class="photo-gallery">
      {gallery.map((img, i) => (
        <div class="gallery-img">
          <img src={img} alt={`SEOULIS Café ${i+1}`} loading="lazy" />
        </div>
      ))}
    </div>
  </section>

  <!-- Waitlist -->
  <section class="section" id="waitlist">
    <div class="waitlist-box">
      <h2 class="display">Be First In.</h2>
      <p>Join the waitlist for early access, opening events, and exclusive benefits.</p>
      <form class="waitlist-form" onsubmit="handleWaitlist(event)">
        <input type="text" placeholder="Your name" required />
        <input type="email" placeholder="your@email.com" required />
        <button class="btn btn-gold" type="submit">Join Waitlist →</button>
      </form>
      <p class="waitlist-note">No spam. Just Seoul. Unsubscribe anytime.</p>
    </div>
  </section>

  <Footer />

  <style>
    .cafe-hero {
      position: relative;
      height: 90svh;
      min-height: 500px;
      display: flex;
      align-items: center;
      overflow: hidden;
    }
    .cafe-hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .cafe-overlay {
      position: relative;
      z-index: 2;
      padding: 2rem 3rem;
      background: linear-gradient(to right, rgba(13,27,42,0.92), transparent);
      max-width: 600px;
    }
    .cafe-coming { color: var(--gold); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.1em; margin-bottom: 0.5rem; }
    .cafe-hero h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); color: var(--white); margin-bottom: 0.5rem; }
    .cafe-sub { color: var(--gray); font-size: 1rem; }

    .cafe-about { max-width: 1000px; }
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
    @media (max-width: 650px) { .about-grid { grid-template-columns: 1fr; } }
    .cafe-about h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); margin-bottom: 1rem; }
    .cafe-about p { color: var(--gray); margin-bottom: 0.75rem; font-size: 0.95rem; }
    .about-stats { display: flex; flex-direction: column; gap: 1.5rem; }
    .stat span { font-size: 2rem; font-weight: 900; color: var(--gold); font-family: var(--font-display); display: block; }
    .stat p { color: var(--gray); font-size: 0.85rem; }

    .menu-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    @media (max-width: 700px) { .menu-grid { grid-template-columns: 1fr; } }
    .menu-item {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.25rem;
      transition: border-color 0.2s;
    }
    .menu-item:hover { border-color: var(--gold); }
    .menu-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem; gap: 0.5rem; }
    .menu-top h3 { font-size: 0.95rem; font-weight: 800; font-family: var(--font-body); }
    .menu-price { color: var(--gold); font-size: 0.85rem; font-weight: 700; flex-shrink: 0; }
    .menu-item p { color: var(--gray); font-size: 0.82rem; line-height: 1.5; }

    .photo-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
    @media (max-width: 600px) { .photo-gallery { grid-template-columns: repeat(2, 1fr); } }
    .gallery-img { border-radius: 12px; overflow: hidden; aspect-ratio: 1; }
    .gallery-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
    .gallery-img:hover img { transform: scale(1.06); }

    .waitlist-box {
      max-width: 580px;
      margin: 0 auto;
      background: var(--card-bg);
      border: 1px solid var(--gold);
      border-radius: 24px;
      padding: 3rem;
      text-align: center;
    }
    .waitlist-box h2 { font-size: 2rem; margin-bottom: 0.75rem; }
    .waitlist-box p { color: var(--gray); margin-bottom: 1.5rem; }
    .waitlist-form { display: flex; flex-direction: column; gap: 0.75rem; }
    .waitlist-form input {
      padding: 0.75rem 1.25rem;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--white);
      font-size: 0.9rem;
      text-align: center;
    }
    .waitlist-note { font-size: 0.75rem; color: var(--gray); margin-top: 0.75rem; margin-bottom: 0 !important; }
  </style>

  <script>
    function handleWaitlist(e) {
      e.preventDefault();
      const btn = e.target.querySelector('button');
      btn.textContent = '✅ You\'re on the list!';
      btn.disabled = true;
      btn.style.background = '#10B981';
    }
  </script>
</body>
</html>
