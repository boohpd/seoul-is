---
import Base from '../layouts/Base.astro';
---
<Base title="About — seoul.is" description="Learn about seoul.is, your daily-updated guide to Seoul and Korea.">
  <main style="max-width:860px;margin:0 auto;padding:60px 24px;color:var(--text);">
    <h1 style="font-size:2.5rem;font-weight:900;margin-bottom:8px;">About <span style="color:var(--primary)">seoul.is</span></h1>
    <p style="color:var(--text-muted);margin-bottom:40px;">Your daily discovery hub for everything Seoul & Korea.</p>

    <h2 style="font-size:1.3rem;font-weight:700;margin-bottom:12px;">Our Mission</h2>
    <p style="line-height:1.8;color:var(--text-secondary);margin-bottom:24px;">seoul.is was built for the millions of global travelers, K-culture fans, and curious minds who want to stay connected with what's happening in Seoul. We aggregate the best content from 50+ premium sources — K-POP, K-DRAMA, food, hotspots, lifestyle, and travel — and deliver it daily in one beautiful place.</p>

    <h2 style="font-size:1.3rem;font-weight:700;margin-bottom:12px;">What We Cover</h2>
    <ul style="line-height:2;color:var(--text-secondary);margin-bottom:24px;padding-left:20px;">
      <li>🎵 K-POP news, comebacks, and artist updates</li>
      <li>📺 K-DRAMA releases, reviews, and streaming guides</li>
      <li>🍜 Seoul restaurant picks, Michelin guides, and food trends</li>
      <li>📍 Hottest neighborhoods, pop-ups, and experiences</li>
      <li>✈️ Travel guides for international visitors to Korea</li>
      <li>🏠 Seoul real estate and lifestyle insights</li>
    </ul>

    <h2 style="font-size:1.3rem;font-weight:700;margin-bottom:12px;">Contact Us</h2>
    <p style="line-height:1.8;color:var(--text-secondary);margin-bottom:8px;">For advertising, partnerships, or general inquiries:</p>
    <p style="color:var(--primary);font-weight:700;">seoulis.info@gmail.com</p>

    <div style="margin-top:40px;padding:24px;background:rgba(255,255,255,0.03);border-radius:12px;border:1px solid rgba(255,255,255,0.06);">
      <p style="color:var(--text-muted);font-size:13px;">seoul.is is operated by K-PROP Limited, Hong Kong.</p>
    </div>
  </main>
</Base>
