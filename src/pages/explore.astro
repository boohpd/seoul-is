---
import Base from '../layouts/Base.astro';

const tours = [
  {
    title: "DMZ Tour from Seoul with Expert Guide",
    category: "Adventure",
    rating: 4.8, reviews: 3241,
    price: "$42",
    duration: "8 hours",
    badge: "Best Seller",
    badgeColor: "#FF2D55",
    img: "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&h=400&fit=crop",
    href: "https://www.klook.com/en-US/activity/1481-dmz-tour-seoul/?aff_adid=1392094&aff_pid=131769"
  },
  {
    title: "Han River Cruise at Night (Rainbow Fountain View)",
    category: "Sightseeing",
    rating: 4.7, reviews: 2891,
    price: "$18",
    duration: "1.5 hours",
    badge: "Popular",
    badgeColor: "#0A84FF",
    img: "https://images.unsplash.com/photo-1567190175497-dc9a0d7b9427?w=600&h=400&fit=crop",
    href: "https://www.klook.com/en-US/activity/3945-han-river-cruise-seoul/?aff_adid=1392094&aff_pid=131769"
  },
  {
    title: "K-Beauty Skincare Class in Myeongdong",
    category: "Culture",
    rating: 4.9, reviews: 1204,
    price: "$35",
    duration: "2 hours",
    badge: "Top Rated",
    badgeColor: "#BF5AF2",
    img: "https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=600&h=400&fit=crop",
    href: "https://www.klook.com/en-US/city/34-seoul-things-to-do/?aff_adid=1392094&aff_pid=131769"
  },
  {
    title: "Gyeongbokgung Palace + Bukchon Hanok Walking Tour",
    category: "History",
    rating: 4.8, reviews: 2105,
    price: "$29",
    duration: "3 hours",
    badge: null,
    badgeColor: "#FF9500",
    img: "https://images.unsplash.com/photo-1578469564783-6e7a07a94b22?w=600&h=400&fit=crop",
    href: "https://www.klook.com/en-US/city/34-seoul-things-to-do/?aff_adid=1392094&aff_pid=131769"
  },
  {
    title: "Nanta Comedy Cooking Show — Center Stage Seats",
    category: "Entertainment",
    rating: 4.6, reviews: 4520,
    price: "$45",
    duration: "1.5 hours",
    badge: "Fan Favorite",
    badgeColor: "#30D158",
    img: "https://images.unsplash.com/photo-1561912774-79769a0a0a7a?w=600&h=400&fit=crop",
    href: "https://www.klook.com/en-US/city/34-seoul-things-to-do/?aff_adid=1392094&aff_pid=131769"
  },
  {
    title: "Seoul Street Food & Night Market Tour",
    category: "Food",
    rating: 4.9, reviews: 987,
    price: "$38",
    duration: "3 hours",
    badge: "Top Rated",
    badgeColor: "#FF9500",
    img: "https://images.unsplash.com/photo-1565299585323-38d6b0865b47?w=600&h=400&fit=crop",
    href: "https://www.klook.com/en-US/city/34-seoul-things-to-do/?aff_adid=1392094&aff_pid=131769"
  },
];

const categories = ["All", "Adventure", "Food", "Culture", "History", "Entertainment", "Sightseeing"];
---

<Base title="Explore Seoul — Tours & Activities 2026 — seoul.is" description="Best Seoul tours and activities: DMZ, Han River cruise, K-beauty class, palace tours, food tours and more. Book instantly on Klook.">
  <div class="explore-page">
    <!-- HERO SEARCH -->
    <div class="explore-hero">
      <h1 class="explore-title">🗺️ Explore Seoul</h1>
      <p class="explore-sub">Best tours, activities and experiences — curated and bookable instantly</p>

      <div class="search-bar">
        <span class="search-icon">🔍</span>
        <input type="text" placeholder="Search tours, activities, experiences..." class="search-input" id="tour-search" />
        <button class="search-btn">Search</button>
      </div>

      <!-- Category tabs -->
      <div class="cat-tabs">
        {categories.map((c, i) => (
          <button class={`cat-tab ${i === 0 ? 'active' : ''}`}>{c}</button>
        ))}
      </div>
    </div>

    <!-- KLOOK WIDGET -->
    <div class="widget-section">
      <div class="widget-label">🎫 Live Activity Search — Powered by Klook</div>
      <div class="klook-widget-wrap">
        <iframe
          src="https://affiliate.klook.com/widget/v1?type=activities&aid=131769&cityId=34&lang=en&currency=USD&width=100%25&height=480&theme=dark"
          width="100%"
          height="480"
          frameborder="0"
          scrolling="no"
          loading="lazy"
          title="Klook Seoul Activities"
          style="border-radius:16px;overflow:hidden;"
        ></iframe>
      </div>
    </div>

    <!-- TOUR GRID -->
    <div class="explore-body">
      <!-- Stats bar -->
      <div class="stats-bar">
        <span class="stats-text">Showing <strong>{tours.length}</strong> curated experiences in Seoul</span>
        <div class="sort-select">
          <select>
            <option>Sort: Best Rated</option>
            <option>Sort: Price Low→High</option>
            <option>Sort: Most Popular</option>
          </select>
        </div>
      </div>

      <div class="tour-grid">
        {tours.map(t => (
          <a href={t.href} target="_blank" rel="noopener sponsored" class="tour-card">
            <div class="tour-img-wrap">
              <img src={t.img} alt={t.title} loading="lazy" />
              {t.badge && (
                <div class="tour-badge" style={`background: ${t.badgeColor};`}>{t.badge}</div>
              )}
              <div class="tour-cat">{t.category}</div>
            </div>
            <div class="tour-body">
              <h3 class="tour-title">{t.title}</h3>
              <div class="tour-meta">
                <span class="tour-rating">
                  ⭐ {t.rating}
                  <span class="tour-reviews">({t.reviews.toLocaleString()})</span>
                </span>
                <span class="tour-duration">⏱ {t.duration}</span>
              </div>
              <div class="tour-bottom">
                <div class="tour-price">
                  <span class="price-from">from</span>
                  <span class="price-val">{t.price}</span>
                  <span class="price-per">/person</span>
                </div>
                <span class="tour-cta">Book →</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Klook CTA -->
      <div class="klook-cta">
        <div class="klook-cta-inner">
          <span class="klook-logo">🎫</span>
          <div>
            <h3>200+ More Activities on Klook</h3>
            <p>Instant booking · Free cancellation · Best price guarantee</p>
          </div>
          <a href="https://www.klook.com/en-US/city/34-seoul-things-to-do/?aff_adid=1392094&aff_pid=131769" target="_blank" rel="noopener sponsored" class="klook-btn">Browse All →</a>
        </div>
      </div>

      <!-- eSIM cross-sell -->
      <div class="esim-banner">
        <span class="esim-icon">📱</span>
        <div class="esim-text">
          <strong>Don't forget your Korea eSIM</strong>
          <span>You'll need mobile data for navigation and tour check-ins. Get connected before you fly.</span>
        </div>
        <a href="https://airalo.tpo.li/rmpJe6nd" target="_blank" rel="noopener sponsored" class="esim-btn">Get eSIM →</a>
      </div>
    </div>
  </div>
</Base>

<style>
.explore-page { min-height: 100vh; }

.explore-hero {
  background: linear-gradient(180deg, #080010 0%, #050505 100%);
  padding: 48px var(--page-pad) 0;
  text-align: center;
}
.explore-title { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 900; margin-bottom: 8px; }
.explore-sub { color: var(--text-secondary); font-size: 1rem; margin-bottom: 24px; }

/* SEARCH */
.search-bar {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--surface);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 16px;
  padding: 10px 10px 10px 16px;
  max-width: 600px;
  margin: 0 auto 20px;
}
.search-icon { font-size: 1.1rem; flex-shrink: 0; }
.search-input {
  flex: 1;
  background: none;
  border: none;
  outline: none;
  color: var(--text);
  font-size: 15px;
  font-family: inherit;
}
.search-input::placeholder { color: var(--text-muted); }
.search-btn {
  background: var(--primary);
  color: white;
  border: none;
  border-radius: 10px;
  padding: 10px 20px;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  font-family: inherit;
  transition: opacity 0.2s;
}
.search-btn:hover { opacity: 0.85; }

/* CAT TABS */
.cat-tabs {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 0 0 20px;
  justify-content: center;
  flex-wrap: wrap;
}
.cat-tab {
  padding: 7px 18px;
  border-radius: 20px;
  border: 1px solid rgba(255,255,255,0.1);
  background: transparent;
  color: var(--text-secondary);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  white-space: nowrap;
}
.cat-tab.active, .cat-tab:hover {
  background: var(--primary);
  border-color: var(--primary);
  color: white;
}

/* BODY */
.explore-body {
  max-width: 1280px;
  margin: 0 auto;
  padding: 32px var(--page-pad) 80px;
}

/* STATS */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  gap: 12px;
  flex-wrap: wrap;
}
.stats-text { font-size: 13px; color: var(--text-secondary); }
.stats-text strong { color: var(--text); }
.sort-select select {
  background: var(--surface);
  border: 1px solid rgba(255,255,255,0.1);
  color: var(--text-secondary);
  font-size: 13px;
  padding: 7px 12px;
  border-radius: 8px;
  outline: none;
  cursor: pointer;
  font-family: inherit;
}

/* TOUR GRID */
.tour-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
  margin-bottom: 40px;
}
@media (min-width: 640px) { .tour-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .tour-grid { grid-template-columns: repeat(3, 1fr); } }

.tour-card {
  background: var(--card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--card-border);
  overflow: hidden;
  text-decoration: none;
  transition: all 0.25s;
  display: flex;
  flex-direction: column;
}
.tour-card:hover {
  border-color: var(--card-border-hover);
  transform: translateY(-3px);
  box-shadow: 0 16px 48px rgba(0,0,0,0.4);
}

.tour-img-wrap {
  position: relative;
  height: 200px;
  overflow: hidden;
}
.tour-img-wrap img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.5s;
}
.tour-card:hover .tour-img-wrap img { transform: scale(1.06); }

.tour-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  font-size: 10px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 20px;
  color: white;
  letter-spacing: 0.5px;
}
.tour-cat {
  position: absolute;
  top: 12px;
  right: 12px;
  font-size: 10px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 20px;
  background: rgba(0,0,0,0.6);
  color: rgba(255,255,255,0.8);
  backdrop-filter: blur(8px);
}

.tour-body { padding: 18px; flex: 1; display: flex; flex-direction: column; gap: 8px; }
.tour-title { font-size: 14px; font-weight: 700; color: var(--text); line-height: 1.4; }
.tour-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 12px;
  color: var(--text-secondary);
}
.tour-rating { display: flex; align-items: center; gap: 4px; font-weight: 600; }
.tour-reviews { color: var(--text-muted); font-weight: 400; }

.tour-bottom {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 10px;
  border-top: 1px solid rgba(255,255,255,0.05);
}
.tour-price { display: flex; align-items: baseline; gap: 3px; }
.price-from { font-size: 11px; color: var(--text-muted); }
.price-val { font-size: 20px; font-weight: 900; color: var(--text); }
.price-per { font-size: 11px; color: var(--text-muted); }
.tour-cta {
  font-size: 13px;
  font-weight: 700;
  color: var(--primary);
  transition: transform 0.2s;
}
.tour-card:hover .tour-cta { transform: translateX(3px); }

/* KLOOK CTA */
.klook-cta {
  margin-bottom: 24px;
  background: rgba(255,45,85,0.06);
  border: 1px solid rgba(255,45,85,0.2);
  border-radius: 16px;
  padding: 24px;
}
.klook-cta-inner {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}
.klook-logo { font-size: 2.5rem; flex-shrink: 0; }
.klook-cta-inner h3 { font-size: 15px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
.klook-cta-inner p { font-size: 13px; color: var(--text-secondary); }
.klook-btn {
  margin-left: auto;
  padding: 12px 24px;
  background: var(--primary);
  color: white;
  border-radius: 10px;
  font-weight: 700;
  font-size: 14px;
  text-decoration: none;
  transition: opacity 0.2s;
  white-space: nowrap;
  flex-shrink: 0;
}
.klook-btn:hover { opacity: 0.85; }

/* eSIM BANNER */
.esim-banner {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 20px 24px;
  background: rgba(48,209,88,0.06);
  border: 1px solid rgba(48,209,88,0.2);
  border-radius: 16px;
  flex-wrap: wrap;
}
.esim-icon { font-size: 2rem; flex-shrink: 0; }
.esim-text { flex: 1; min-width: 0; }
.esim-text strong { display: block; color: var(--text); font-size: 14px; margin-bottom: 3px; }
.esim-text span { color: var(--text-secondary); font-size: 13px; }
.esim-btn {
  padding: 10px 20px;
  background: #30D158;
  color: black;
  border-radius: 10px;
  font-weight: 700;
  font-size: 13px;
  text-decoration: none;
  flex-shrink: 0;
  transition: opacity 0.2s;
}
.esim-btn:hover { opacity: 0.85; }

/* WIDGET */
.widget-section {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 var(--page-pad) 40px;
}
.widget-label {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--text-muted);
  margin-bottom: 14px;
}
.klook-widget-wrap {
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.08);
  background: var(--card);
  min-height: 480px;
}
</style>
