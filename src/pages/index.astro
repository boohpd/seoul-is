---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const featuredArticles = [{"slug": "best-cafes-seoul-2026", "title": "Best Cafes in Seoul 2026: Specialty Coffee & Unique Spots", "category": "Food", "readTime": "4 min read", "heroImage": "https://images.unsplash.com/photo-1538485399081-7191377e8241?w=600&q=80", "url": "/article/best-cafes-seoul-2026"}, {"slug": "best-kdramas-2026-to-watch", "title": "Best K-Dramas of 2026: The Ultimate Watch List", "category": "kdrama", "readTime": "8 min read", "heroImage": "https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=600&q=80", "url": "/article/best-kdramas-2026-to-watch"}, {"slug": "best-korean-bbq-seoul-2026", "title": "Best Korean BBQ in Seoul 2026: From ₩10,000 to ₩100,000", "category": "food", "readTime": "9 min read", "heroImage": "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=600&q=80", "url": "/article/best-korean-bbq-seoul-2026"}, {"slug": "best-kpop-songs-2026-ranked", "title": "Top 50 K-Pop Songs of 2026: The Definitive Ranking", "category": "ranking", "readTime": "12 min read", "heroImage": "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=600&q=80", "url": "/article/best-kpop-songs-2026-ranked"}, {"slug": "best-restaurants-seoul-2026", "title": "Best Restaurants in Seoul 2026: Where to Eat Like a Local", "category": "Food", "readTime": "4 min read", "heroImage": "https://images.unsplash.com/photo-1483985988355-763728e1935b?w=600&q=80", "url": "/article/best-restaurants-seoul-2026"}, {"slug": "blackpink-2026-world-tour-seoul", "title": "BLACKPINK 2026 World Tour: What to Expect at Seoul Concerts", "category": "kpop", "readTime": "5 min read", "heroImage": "https://images.unsplash.com/photo-1511192336575-5a79af67a629?w=600&q=80", "url": "/article/blackpink-2026-world-tour-seoul"}, {"slug": "bts-arirang-album-review-2026", "title": "BTS \"Arirang\" Review: A Triumphant Return That Redefines K-Pop", "category": "kpop", "readTime": "7 min read", "heroImage": "https://images.unsplash.com/photo-1478720568477-152d9b164e26?w=600&q=80", "url": "/article/bts-arirang-album-review-2026"}, {"slug": "bukchon-hanok-village-guide", "title": "Bukchon Hanok Village Guide: Tips for Visiting Seoul's Heritage Gem", "category": "Culture", "readTime": "8 min read", "heroImage": "https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=600&q=80", "url": "/article/bukchon-hanok-village-guide"}, {"slug": "gangnam-guide", "title": "Gangnam Guide: Shopping, Nightlife & More in Seoul's Glitziest District", "category": "Neighborhoods", "readTime": "8 min read", "heroImage": "https://images.unsplash.com/photo-1535093787143-f854c8d5e416?w=600&q=80", "url": "/article/gangnam-guide"}, {"slug": "gyeongbokgung-palace-guide", "title": "Gyeongbokgung Palace Guide: Seoul's Most Iconic Royal Site", "category": "Attractions", "readTime": "7 min read", "heroImage": "https://images.unsplash.com/photo-1517154421773-0855edd6b4f3?w=600&q=80", "url": "/article/gyeongbokgung-palace-guide"}, {"slug": "hongdae-things-to-do", "title": "Hongdae Guide: Art, Music & Nightlife in Seoul's Youth District", "category": "Neighborhoods", "readTime": "6 min read", "heroImage": "https://images.unsplash.com/photo-1534430480872-3498386e7856?w=600&q=80", "url": "/article/hongdae-things-to-do"}, {"slug": "incheon-airport-guide", "title": "Incheon Airport Guide: Layovers, Transit & Getting to Seoul", "category": "Transport", "readTime": "8 min read", "heroImage": "https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=600&q=80", "url": "/article/incheon-airport-guide"}];

const categoryColors = {
  kpop: 'pill-kpop',
  kdrama: 'pill-kdrama',
  food: 'pill-food',
  places: 'pill-places',
  travel: 'pill-travel',
};

// JSON 파일에서 동적 데이터 로드 (n8n이 자동 업데이트)
// Static data — Cloudflare Pages SSG 호환
const weatherData = [
  { city: 'Seoul', icon: '🌤', temp: '13°C', condition: 'Partly Cloudy', outfit: 'Light jacket + scarf', style: '🧥 K-Style: Oversized blazer + trousers', img: 'https://images.unsplash.com/photo-1538485399081-7191377e8241?w=600&q=80' },
  { city: 'Busan', icon: '☀️', temp: '17°C', condition: 'Sunny', outfit: 'T-shirt + cardigan', style: '👕 K-Style: Knit top + wide-leg pants', img: 'https://images.unsplash.com/photo-1535093787143-f854c8d5e416?w=600&q=80' },
  { city: 'Jeju', icon: '🌈', temp: '18°C', condition: 'Clear & breezy', outfit: 'Casual layers', style: '🌿 K-Style: Linen shirt + chinos', img: 'https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=600&q=80' },
];
const events = [
  { title: 'Seoul Lantern Festival 2026', date: 'Nov 1–17, 2026', location: 'Cheonggyecheon Stream', img: 'https://images.unsplash.com/photo-1517154421773-0855edd6b4f3?w=600&q=80', url: 'https://www.seoullantern.com', emoji: '🏮' },
  { title: 'K-Pop World Festival', date: 'Nov 8, 2026', location: 'Seoul Olympic Park', img: 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=600&q=80', url: '#', emoji: '🎤' },
  { title: 'Busan International Film Festival', date: 'Nov–Dec 2026', location: 'Busan Cinema Center', img: 'https://images.unsplash.com/photo-1478720568477-152d9b164e26?w=600&q=80', url: 'https://www.biff.kr', emoji: '🎬' },
  { title: 'Seoul Fashion Week', date: 'Oct–Nov 2026', location: 'Dongdaemun DDP', img: 'https://images.unsplash.com/photo-1483985988355-763728e1935b?w=600&q=80', url: '#', emoji: '👗' },
  { title: 'Gyeongbokgung Night Tour', date: 'Oct–Nov 2026', location: 'Gyeongbokgung Palace', img: 'https://images.unsplash.com/photo-1517154421773-0855edd6b4f3?w=600&q=80', url: 'https://www.royalpalace.go.kr', emoji: '🏯' },
  { title: 'Korea Food & Travel Expo', date: 'Nov 14–17, 2026', location: 'COEX, Seoul', img: 'https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=600&q=80', url: '#', emoji: '🍜' },
];
const tickerData = { items: ['🏮 Seoul Lantern Festival runs Nov 1–17 at Cheonggyecheon Stream','🎤 K-Pop World Festival headlines Seoul Olympic Park on Nov 8','👗 Seoul Fashion Week wraps up at DDP — highlights inside','🍜 Michelin Guide Seoul 2026 reveals new starred restaurants','🌟 BTS member Jin returns — solo concert dates confirmed','🎬 BIFF 2026 closes with record attendance of 220,000','🏃 Han River Park autumn picnic season peaks this weekend','✈️ Incheon Airport ranked #1 in Asia for 2026'] };

// events는 이미 JSON에서 로드됨
const essentials = [
  { emoji: '💳', title: 'T-Money Card' },
  { emoji: '📱', title: 'Pocket WiFi / eSIM' },
  { emoji: '🏥', title: 'Travel Insurance' },
  { emoji: '💊', title: 'Basic Meds' },
  { emoji: '👟', title: 'Comfortable Shoes' },
  { emoji: '🌂', title: 'Compact Umbrella' },
  { emoji: '🔌', title: 'Universal Adapter' },
  { emoji: '💰', title: 'Korean Won Cash' },
];

const courses = [
  { name: 'Hongdae', tagline: 'Art, music & street vibes', img: 'https://images.unsplash.com/photo-1583623025817-d180a2221d0a?w=600&q=80' },
  { name: 'Gangnam', tagline: 'Luxury, K-pop & nightlife', img: 'https://images.unsplash.com/photo-1601621915196-2621bfb0cd6e?w=600&q=80' },
  { name: 'Insadong', tagline: 'Culture, tea & tradition', img: 'https://images.unsplash.com/photo-1578662996442-48f60103fc96?w=600&q=80' },
  { name: 'Jeju Island', tagline: 'Nature, beaches & volcanic wonder', img: 'https://images.unsplash.com/photo-1548196589-7b30f92b8454?w=600&q=80' },
];


---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Seoul.is — Seoul Is Where You Belong</title>
  <meta name="description" content="Your ultimate guide to Seoul — K-pop, food, travel, culture and everything in between." />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <Header />

  <!-- LIVE Banner -->
  <div class="live-banner">
    <span class="live-dot"></span>
    <span class="live-label">LIVE</span>
    <div class="ticker-wrap">
      <span class="ticker-text">{tickerData.items.join(' · ')} ·</span>
    </div>
  </div>

  <!-- HERO -->
  <section class="hero">
    <img class="hero-bg" src="https://images.unsplash.com/photo-1538485399081-7191377e8241?w=1600&q=80" alt="Seoul skyline" loading="eager" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1 class="hero-headline display">Seoul Is Where<br/>You Belong</h1>
      <div class="hero-langs">
        <span>서울에 어서 오세요</span>
        <span>ソウルへようこそ</span>
        <span>首尔欢迎您</span>
        <span>Chào mừng đến Seoul</span>
        <span>ยินดีต้อนรับสู่โซล</span>
        <span>Selamat datang di Seoul</span>
      </div>
      <div class="hero-ctas">
        <a href="/courses" class="btn btn-gold">Explore Seoul →</a>
        <a href="#weather" class="btn btn-outline">🌤 Today's Weather</a>
      </div>
    </div>
  </section>

  <!-- WEATHER -->
  <section class="section" id="weather">
    <h2 class="section-title">🌤 <span data-i18n="sec_weather">Today's Weather & What to Wear</span></h2>
    <div class="weather-grid">
      {weatherData.map(w => (
        <div class="weather-card">
          <img src={w.img} alt={w.city} loading="lazy" />
          <div class="weather-body">
            <div class="weather-top">
              <span class="weather-city">{w.city}</span>
              <span class="weather-temp">{w.icon} {w.temp}</span>
            </div>
            <p class="weather-condition">{w.condition}</p>
            <p class="weather-outfit">{w.style || ('👗 ' + w.outfit)}</p>
            <p class="weather-tip" style="font-size:0.78rem;color:rgba(255,255,255,0.45);margin-top:4px;">{w.outfit}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CONTENT GRID -->
  <section class="section reveal">
    <h2 class="section-title">📲 <span data-i18n="sec_latest">Latest from Seoul</span></h2>
    <div class="card-grid">
      {featuredArticles.map(article => (
        <a href={article?.url ?? '#'} class="content-card">
          <div class="card-img-wrap">
            <img
              src={article?.heroImage ?? `https://images.unsplash.com/photo-1538485399081-7191377e8241?w=600&q=80`}
              alt={article?.title ?? ''}
              loading="lazy"
              onerror="this.src='https://images.unsplash.com/photo-1538485399081-7191377e8241?w=600&q=80'"
            />
            <span class={`pill ${categoryColors[article?.category] ?? 'pill-places'}`}>{(article?.category ?? 'Seoul').toUpperCase()}</span>
          </div>
          <div class="card-body">
            <h3 class="card-title">{article?.title}</h3>
            <span class="card-meta">{article?.readTime ?? '5 min read'}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ESSENTIALS STRIP -->
  <section class="section reveal">
    <h2 class="section-title">🧳 <span data-i18n="sec_essentials">Korea Essentials for First-Timers</span></h2>
    <div class="scroll-strip essentials-strip">
      {essentials.map(e => (
        <a href="/essentials" class="essential-card">
          <span class="essential-emoji">{e.emoji}</span>
          <span class="essential-title">{e.title}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- COURSES -->
  <section class="section reveal">
    <h2 class="section-title">🗺 Must-Do <span>Courses</span></h2>
    <div class="courses-grid">
      {courses.map(c => (
        <a href="/courses" class="course-card">
          <img src={c.img} alt={c.name} loading="lazy" />
          <div class="course-overlay">
            <h3 class="course-name">{c.name}</h3>
            <p class="course-tagline">{c.tagline}</p>
            <span class="course-cta">Explore →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- APP + PAY BANNER -->
  <section class="section reveal" style="padding-top:0;">
    <div class="platform-grid">
      <!-- App -->
      <div class="platform-card platform-app">
        <div class="platform-badge">📱 Seoul.is App</div>
        <h2 class="platform-title">Discover Seoul<br/>Like a Local</h2>
        <p class="platform-desc">K-Local Ratio™ shows you which spots locals actually love vs. tourist traps. LinkDrop™ lets you share any spot instantly via NFC.</p>
        <div class="platform-ctas">
          <a href="#" class="btn btn-gold" style="font-size:0.85rem;padding:10px 20px;">🍎 App Store</a>
          <a href="#" class="btn btn-outline" style="font-size:0.85rem;padding:10px 20px;">▶ Google Play</a>
        </div>
      </div>
      <!-- Pay -->
      <div class="platform-card platform-pay">
        <div class="platform-badge">💳 Seoul.is Pay</div>
        <h2 class="platform-title">Pay & Get Your<br/>Tax Back — Instantly</h2>
        <p class="platform-desc">No more airport queues for tax refunds. Seoul.is Pay processes your VAT refund the moment you pay — right at the register.</p>
        <div class="platform-stats">
          <div class="pstat"><span class="pstat-num">40%→90%</span><span class="pstat-label">Tax refund rate</span></div>
          <div class="pstat"><span class="pstat-num">₩0</span><span class="pstat-label">Setup fee</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CAFÉ BANNER -->
  <section class="cafe-banner reveal">
    <img src="https://images.unsplash.com/photo-1559925393-8be0ec4767c8?w=1400&q=80" alt="SEOULIS Café" loading="lazy" />
    <div class="cafe-overlay">
      <h2 class="cafe-title display">SEOULIS SPOT</h2>
      <p class="cafe-sub">Opening in Hongdae 2027</p>
      <p class="cafe-desc">AI Photo Booth · K-beauty · Community Board · Connect Lounge</p>
      <a href="/spot" class="btn btn-gold">Learn More →</a>
    </div>
  </section>

  <!-- EVENTS -->
  <section class="section reveal">
    <h2 class="section-title">📅 <span data-i18n="sec_events">Upcoming Events</span></h2>
    <div class="events-grid">
      {events.map(ev => (
        <div class="event-card">
          <div class="event-img-wrap">
            <img src={ev.img} alt={ev.title} loading="lazy" />
            <span class="badge-dday">D-{ev.days}</span>
          </div>
          <div class="event-body">
            <p class="event-date">{ev.date}</p>
            <h3 class="event-title">{ev.title}</h3>
            <p class="event-location">📍 {ev.location}</p>
            <a href="/events" class="btn btn-outline" style="margin-top:0.75rem;font-size:0.8rem;">Get Info →</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- MEMBERSHIP (subtle, bottom) -->
  <section class="section reveal">
    <div class="mem-teaser">
      <div class="mem-teaser-left">
        <div class="platform-badge" style="margin-bottom:12px;">✦ Seoul Prime Club</div>
        <h2 style="font-size:1.6rem;font-weight:900;margin-bottom:10px;">Unlock the full Seoul experience</h2>
        <p style="color:rgba(255,255,255,0.55);font-size:0.9rem;line-height:1.7;max-width:420px;">From free content to exclusive SPOT lounge access, NFC smart card, and curated insider guides. Start free, upgrade anytime.</p>
      </div>
      <div class="mem-tiers">
        <div class="mem-tier">
          <span class="mem-tier-name">Free</span>
          <span class="mem-tier-price">₩0</span>
        </div>
        <div class="mem-tier">
          <span class="mem-tier-name">Seoul Pass</span>
          <span class="mem-tier-price">₩9,900<small>/mo</small></span>
        </div>
        <div class="mem-tier featured">
          <span class="mem-tier-name">Seoul Prime ⭐</span>
          <span class="mem-tier-price">₩29,900<small>/mo</small></span>
        </div>
        <a href="/membership" class="btn btn-gold" style="font-size:0.85rem;padding:10px 20px;white-space:nowrap;">View Plans →</a>
      </div>
    </div>
  </section>

  <!-- LANGUAGE SWITCHER (floating) -->
  <div class="lang-float">
    {['EN','KO','JA','ZH','VI','TH','ID','AR','MS'].map(l => (
      <button class={`lang-float-btn ${l === 'EN' ? 'active' : ''}`} data-lang={l}>{l}</button>
    ))}
  </div>

  <div id="lang-toast"></div>

  <Footer />

  <style>
    /* Live Banner */
    .live-banner {
      background: linear-gradient(90deg, #1a0a10 0%, #1a0012 100%);
      border-bottom: 1px solid var(--red);
      padding: 0.5rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      overflow: hidden;
    }
    .live-label {
      color: var(--red);
      font-size: 0.75rem;
      font-weight: 900;
      letter-spacing: 0.1em;
      flex-shrink: 0;
    }

    /* Hero */
    .hero {
      position: relative;
      height: 100svh;
      min-height: 560px;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(13,27,42,0.97) 0%, rgba(13,27,42,0.4) 60%, transparent 100%);
    }
    .hero-content {
      position: relative;
      z-index: 2;
      padding: 3rem 2rem 4rem;
      max-width: 1200px;
      margin: 0 auto;
      width: 100%;
    }
    .hero-headline {
      font-size: clamp(2.5rem, 7vw, 5.5rem);
      font-weight: 900;
      line-height: 1.05;
      color: var(--white);
      margin-bottom: 1rem;
    }
    .hero-langs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
      margin-bottom: 1.75rem;
      opacity: 0.7;
      font-size: 0.9rem;
    }
    .hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; }

    /* Weather */
    .weather-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    @media (max-width: 700px) { .weather-grid { grid-template-columns: 1fr; } }
    .weather-card {
      background: var(--card-bg);
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .weather-card img { width: 100%; height: 140px; object-fit: cover; }
    .weather-body { padding: 1rem; }
    .weather-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
    .weather-city { font-weight: 800; font-size: 1.1rem; }
    .weather-temp { font-size: 1.1rem; color: var(--gold); }
    .weather-condition { color: var(--gray); font-size: 0.85rem; margin-bottom: 0.4rem; }
    .weather-outfit { font-size: 0.82rem; color: #aac; }

    /* Content Cards */
    .content-card {
      background: var(--card-bg);
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid var(--border);
      transition: transform 0.25s, border-color 0.25s;
      display: block;
    }
    .content-card:hover { transform: scale(1.02); border-color: var(--gold); }
    .card-img-wrap { position: relative; aspect-ratio: 16/9; overflow: hidden; }
    .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
    .content-card:hover .card-img-wrap img { transform: scale(1.05); }
    .card-img-wrap .pill { position: absolute; top: 10px; left: 10px; }
    .card-body { padding: 0.9rem 1rem; }
    .card-title { font-size: 0.92rem; font-weight: 700; line-height: 1.35; margin-bottom: 0.4rem; color: var(--white); font-family: var(--font-body); }
    .card-meta { color: var(--gray); font-size: 0.78rem; }

    /* Essentials */
    .essentials-strip { padding-bottom: 0.5rem; }
    .essential-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.25rem 1.5rem;
      min-width: 130px;
      flex-shrink: 0;
      transition: border-color 0.2s, background 0.2s;
      text-align: center;
    }
    .essential-card:hover { border-color: var(--gold); background: rgba(201,168,76,0.08); }
    .essential-emoji { font-size: 2rem; }
    .essential-title { font-size: 0.8rem; font-weight: 600; color: var(--white); }

    /* Courses */
    .courses-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    @media (max-width: 900px) { .courses-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 500px) { .courses-grid { grid-template-columns: 1fr; } }
    .course-card {
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      aspect-ratio: 3/4;
      display: block;
    }
    .course-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
    .course-card:hover img { transform: scale(1.06); }
    .course-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 50%);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 1.25rem;
    }
    .course-name { font-size: 1.2rem; font-weight: 900; }
    .course-tagline { font-size: 0.78rem; color: rgba(255,255,255,0.75); margin: 0.2rem 0 0.6rem; }
    .course-cta { color: var(--gold); font-size: 0.82rem; font-weight: 700; }

    /* Café Banner */
    .cafe-banner {
      position: relative;
      height: 400px;
      overflow: hidden;
      margin: 0 0 1rem;
    }
    .cafe-banner img { width: 100%; height: 100%; object-fit: cover; }
    .cafe-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, rgba(13,27,42,0.9) 0%, rgba(13,27,42,0.4) 100%);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 3rem;
    }
    .cafe-title { font-size: clamp(1.8rem, 4vw, 3rem); color: var(--gold); margin-bottom: 0.25rem; }
    .cafe-sub { font-size: 1rem; color: var(--white); margin-bottom: 0.25rem; }
    .cafe-desc { color: var(--gray); font-size: 0.9rem; margin-bottom: 1.25rem; }

    /* Events */
    .events-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
    @media (max-width: 800px) { .events-grid { grid-template-columns: 1fr; } }
    .event-card {
      background: var(--card-bg);
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .event-img-wrap { position: relative; }
    .event-img-wrap img { width: 100%; height: 180px; object-fit: cover; }
    .event-img-wrap .badge-dday { position: absolute; top: 10px; right: 10px; }
    .event-body { padding: 1rem 1.25rem 1.25rem; }
    .event-date { color: var(--gold); font-size: 0.8rem; font-weight: 700; margin-bottom: 0.3rem; }
    .event-title { font-size: 1rem; font-weight: 800; margin-bottom: 0.3rem; font-family: var(--font-body); }
    .event-location { color: var(--gray); font-size: 0.82rem; }

    /* Platform Grid */
    .platform-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
    @media (max-width: 700px) { .platform-grid { grid-template-columns: 1fr; } }
    .platform-card {
      border-radius: 20px;
      padding: 2rem;
      border: 1px solid var(--border);
    }
    .platform-app { background: linear-gradient(135deg, rgba(13,27,42,0.9), rgba(30,50,80,0.6)); }
    .platform-pay { background: linear-gradient(135deg, rgba(201,168,76,0.08), rgba(13,27,42,0.9)); }
    .platform-badge {
      display: inline-block;
      background: rgba(201,168,76,0.15);
      border: 1px solid rgba(201,168,76,0.3);
      color: var(--gold);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1px;
      padding: 4px 14px;
      border-radius: 20px;
      margin-bottom: 16px;
    }
    .platform-title { font-size: 1.5rem; font-weight: 900; line-height: 1.25; margin-bottom: 12px; }
    .platform-desc { color: rgba(255,255,255,0.6); font-size: 0.9rem; line-height: 1.7; margin-bottom: 20px; }
    .platform-ctas { display: flex; gap: 10px; flex-wrap: wrap; }
    .platform-stats { display: flex; gap: 2rem; margin-top: 20px; }
    .pstat { display: flex; flex-direction: column; }
    .pstat-num { font-size: 1.4rem; font-weight: 900; color: var(--gold); }
    .pstat-label { font-size: 0.75rem; color: rgba(255,255,255,0.45); }

    /* Membership Teaser */
    .mem-teaser {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 2rem 2.5rem;
      display: flex;
      align-items: center;
      gap: 2rem;
      flex-wrap: wrap;
    }
    .mem-teaser-left { flex: 1; min-width: 240px; }
    .mem-tiers { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; flex-shrink: 0; }
    .mem-tier {
      display: flex; flex-direction: column;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 10px 16px;
      text-align: center;
    }
    .mem-tier.featured { border-color: var(--gold); background: rgba(201,168,76,0.08); }
    .mem-tier-name { font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.5); margin-bottom: 4px; }
    .mem-tier-price { font-size: 1rem; font-weight: 900; color: var(--white); }
    .mem-tier.featured .mem-tier-price { color: var(--gold); }
    .mem-tier-price small { font-size: 0.65rem; font-weight: 400; color: rgba(255,255,255,0.4); }

    /* Lang Float */
    .lang-float {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 6px;
      z-index: 500;
    }
    .lang-float-btn {
      background: var(--card-bg);
      border: 1px solid var(--border);
      color: var(--gray);
      font-size: 0.72rem;
      font-weight: 700;
      padding: 5px 10px;
      border-radius: 999px;
      transition: all 0.2s;
    }
    .lang-float-btn.active, .lang-float-btn:hover {
      background: var(--gold);
      color: #000;
      border-color: var(--gold);
    }
  </style>

