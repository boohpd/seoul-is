---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import CategorySection from '../components/CategorySection.astro';
import Footer from '../components/Footer.astro';
import { getAllContent, getFeatured, getMeta } from '../lib/content.js';
import { CATEGORIES, CAT_ORDER } from '../lib/categories.js';

const content = getAllContent();
const meta = getMeta();
const featuredArticles = getFeatured().slice(0, 6);

const heroArticle = featuredArticles[0];
const gridArticles = featuredArticles.slice(1, 5);
---

<Base>
  <Header />

  <main class="main-content">

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <div class="hero-bg">
        <img
          src="https://images.unsplash.com/photo-1538485399081-7191377e8241?w=1600&q=80"
          alt="Seoul night skyline"
          class="hero-img"
          loading="eager"
        />
        <div class="hero-overlay"></div>
      </div>
      <div class="hero-content animate-fade-in-up">
        <div class="hero-eyebrow">ISSUE NO.1 · OCTOBER 2026</div>
        <h1 class="hero-title">Seoul Is Where<br/>You Belong</h1>
        <p class="hero-sub">Your daily guide to K-culture, curated from 50+ sources in 8 languages</p>
        <a href="/articles" class="hero-cta">Read Today's Edition →</a>
      </div>
      <div class="hero-scroll-indicator">
        <div class="scroll-line"></div>
      </div>
    </section>

    <!-- ═══ LIVE TICKER ═══ -->
    <div class="ticker-wrapper">
      <div class="ticker-inner">
        <div class="ticker-track">
          <span class="ticker-text">✦ K-POP &nbsp;·&nbsp; K-DRAMA &nbsp;·&nbsp; FOOD &nbsp;·&nbsp; HOT PLACES &nbsp;·&nbsp; LIFESTYLE &nbsp;·&nbsp; TRAVEL &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
          <span class="ticker-text">✦ K-POP &nbsp;·&nbsp; K-DRAMA &nbsp;·&nbsp; FOOD &nbsp;·&nbsp; HOT PLACES &nbsp;·&nbsp; LIFESTYLE &nbsp;·&nbsp; TRAVEL &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
          <span class="ticker-text">✦ K-POP &nbsp;·&nbsp; K-DRAMA &nbsp;·&nbsp; FOOD &nbsp;·&nbsp; HOT PLACES &nbsp;·&nbsp; LIFESTYLE &nbsp;·&nbsp; TRAVEL &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
          <span class="ticker-text">✦ K-POP &nbsp;·&nbsp; K-DRAMA &nbsp;·&nbsp; FOOD &nbsp;·&nbsp; HOT PLACES &nbsp;·&nbsp; LIFESTYLE &nbsp;·&nbsp; TRAVEL &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
        </div>
      </div>
    </div>

    <!-- ═══ FEATURED ARTICLES ═══ -->
    {featuredArticles.length > 0 && (
      <section class="featured-section animate-fade-in delay-2">
        <div class="editorial-header">
          <h2 class="editorial-title">Featured Articles</h2>
          <a href="/articles" class="editorial-link">View All →</a>
        </div>

        {/* Lead article — full width */}
        {heroArticle && (
          <a href={`/article/${heroArticle.slug}`} class="lead-card card-hover-gold">
            {heroArticle?.heroImage && (
              <div class="lead-card-img">
                <img src={heroArticle.heroImage} alt={heroArticle?.title || ''} loading="lazy" />
              </div>
            )}
            <div class="lead-card-body">
              <span class="editorial-cat">{heroArticle?.category}</span>
              <h2 class="lead-card-title">{heroArticle?.title}</h2>
              {heroArticle.description && (
                <p class="lead-card-desc">{heroArticle.description}</p>
              )}
            </div>
          </a>
        )}

        {/* 2×2 grid */}
        {gridArticles.length > 0 && (
          <div class="grid-articles">
            {gridArticles.map(article => (
              <a href={`/article/${article.slug}`} class="grid-card card-hover-gold">
                {article?.heroImage && (
                  <div class="grid-card-img">
                    <img src={article.heroImage} alt={article?.title || ''} loading="lazy" />
                  </div>
                )}
                <div class="grid-card-body">
                  <span class="editorial-cat">{article?.category}</span>
                  <h3 class="grid-card-title">{article?.title}</h3>
                </div>
              </a>
            ))}
          </div>
        )}
      </section>
    )}

    <!-- ═══ CATEGORY SECTIONS ═══ -->
    <div class="sections-wrapper">
      {CAT_ORDER.map((catId) => (
        <div class="section-block">
          <CategorySection categoryId={catId} items={content[catId] || []} />
        </div>
      ))}
    </div>

    <!-- ═══ SPOT BANNER ═══ -->
    <section class="spot-banner animate-fade-in">
      <div class="spot-bg">
        <img
          src="https://images.unsplash.com/photo-1601621915196-2621bfb0cd6e?w=1400&q=80"
          alt="Seoul city"
          class="spot-img"
          loading="lazy"
        />
        <div class="spot-overlay"></div>
      </div>
      <div class="spot-content">
        <div class="spot-eyebrow">SEOULIS SPOT</div>
        <h2 class="spot-title">Transform Your Café<br/>Into a SEOULIS SPOT</h2>
        <p class="spot-desc">Get featured in Seoul's most curated editorial platform. Connect with K-culture lovers worldwide.</p>
        <a href="/spot" class="spot-cta">Apply Now →</a>
      </div>
    </section>

    <!-- ═══ MEMBERSHIP ═══ -->
    <section class="membership-section animate-fade-in">
      <div class="editorial-header editorial-header--center">
        <h2 class="editorial-title">Seoul Prime Club</h2>
        <p class="membership-subtitle">Choose your level of access to the Seoul you've always wanted</p>
      </div>
      <div class="tier-grid">
        <!-- FREE -->
        <div class="tier-card">
          <div class="tier-name">FREE</div>
          <div class="tier-price">₩0<span class="tier-period">/month</span></div>
          <ul class="tier-features">
            <li>Daily K-culture news</li>
            <li>Articles in 8 languages</li>
            <li>Basic neighborhood guides</li>
            <li>Community access</li>
          </ul>
          <a href="/membership" class="tier-btn tier-btn--outline">Get Started</a>
        </div>

        <!-- SEOUL PASS (featured) -->
        <div class="tier-card tier-card--featured">
          <div class="badge-recommended">Recommended</div>
          <div class="tier-name">SEOUL PASS</div>
          <div class="tier-price">₩9,900<span class="tier-period">/month</span></div>
          <ul class="tier-features">
            <li>Everything in Free</li>
            <li>Exclusive SPOT discounts</li>
            <li>Priority article access</li>
            <li>Monthly Seoul insider briefing</li>
            <li>Ad-free experience</li>
          </ul>
          <a href="/membership" class="tier-btn tier-btn--gold">Join Now</a>
        </div>

        <!-- SEOUL PRIME -->
        <div class="tier-card">
          <div class="tier-name">SEOUL PRIME</div>
          <div class="tier-price">₩29,900<span class="tier-period">/month</span></div>
          <ul class="tier-features">
            <li>Everything in Seoul Pass</li>
            <li>Private Telegram community</li>
            <li>VIP SPOT reservations</li>
            <li>1-on-1 Seoul concierge</li>
            <li>Exclusive events & meetups</li>
          </ul>
          <a href="/membership" class="tier-btn tier-btn--outline">Join Now</a>
        </div>
      </div>
    </section>

    <!-- ═══ NEWSLETTER ═══ -->
    <section class="newsletter-section animate-fade-in">
      <h2 class="newsletter-title">Get Seoul's Best Weekly</h2>
      <p class="newsletter-sub">Curated K-culture highlights, delivered every Monday morning.</p>
      <form class="newsletter-form" action="mailto:hello@seoul.is" method="get">
        <input type="email" name="subject" placeholder="Your email address" class="newsletter-input" required />
        <button type="submit" class="newsletter-btn">Subscribe →</button>
      </form>
    </section>

    <!-- ═══ LAST UPDATED ═══ -->
    {meta.lastUpdated && (
      <div class="last-updated">
        <span class="last-updated-dot"></span>
        Last updated: {new Date(meta.lastUpdated).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })}
      </div>
    )}

  </main>

  <Footer />
</Base>

<style>
  .main-content {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--page-pad);
  }

  /* ══════════════════ HERO ══════════════════ */
  .hero {
    position: relative;
    margin: 0 calc(-1 * var(--page-pad));
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(13,27,42,0.5) 0%, rgba(13,27,42,0.85) 60%, #0D1B2A 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 760px;
    padding: 0 24px;
  }

  .hero-eyebrow {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 28px;
  }

  .hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(48px, 9vw, 96px);
    font-weight: 900;
    letter-spacing: -1px;
    line-height: 1.05;
    color: #ffffff;
    margin-bottom: 24px;
  }

  .hero-sub {
    font-family: 'Inter', sans-serif;
    font-size: clamp(15px, 2vw, 18px);
    font-weight: 300;
    color: rgba(255,255,255,0.6);
    line-height: 1.7;
    max-width: 520px;
    margin: 0 auto 40px;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    padding: 16px 36px;
    background: var(--color-gold);
    color: #0D1B2A;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
    border-radius: 4px;
    transition: all var(--transition-fast);
  }
  .hero-cta:hover {
    background: #d9b85c;
    box-shadow: 0 8px 28px rgba(201,168,76,0.45);
    transform: translateY(-2px);
  }

  .hero-scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .scroll-line {
    width: 1px;
    height: 60px;
    background: var(--color-gold);
    animation: scrollLine 2s ease-in-out infinite;
    transform-origin: top;
  }

  /* ══════════════════ TICKER ══════════════════ */
  .ticker-wrapper {
    margin: 0 calc(-1 * var(--page-pad));
    overflow: hidden;
    background: var(--color-dark2);
    border-top: 1px solid rgba(201,168,76,0.15);
    border-bottom: 1px solid rgba(201,168,76,0.15);
    padding: 10px 0;
  }

  .ticker-inner {
    overflow: hidden;
    white-space: nowrap;
  }

  .ticker-text {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  /* ══════════════════ EDITORIAL HEADERS ══════════════════ */
  .editorial-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 40px;
    padding-left: 16px;
    border-left: 2px solid var(--color-gold);
  }

  .editorial-header--center {
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-left: none;
    padding-left: 0;
    gap: 10px;
    margin-bottom: 48px;
  }

  .editorial-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 700;
    color: #ffffff;
  }

  .editorial-link {
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--color-gold);
    transition: opacity var(--transition-fast);
  }
  .editorial-link:hover { opacity: 0.65; }

  .editorial-cat {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-gold);
    display: block;
    margin-bottom: 10px;
  }

  /* ══════════════════ FEATURED ══════════════════ */
  .featured-section {
    margin: 80px 0;
  }

  /* Lead card */
  .lead-card {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-lg);
    margin-bottom: 20px;
    text-decoration: none;
    position: relative;
  }

  .lead-card-img {
    width: 100%;
    aspect-ratio: 16/7;
    overflow: hidden;
    background: #0f1e30;
  }
  .lead-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  .lead-card:hover .lead-card-img img {
    transform: scale(1.03);
  }

  .lead-card-body {
    padding: 28px 0 0;
  }

  .lead-card-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(26px, 4vw, 44px);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    margin-bottom: 12px;
  }

  .lead-card-desc {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 300;
    color: rgba(255,255,255,0.5);
    line-height: 1.7;
    max-width: 640px;
  }

  /* Grid articles */
  .grid-articles {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 20px;
  }

  .grid-card {
    display: block;
    text-decoration: none;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .grid-card-img {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #0f1e30;
  }
  .grid-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }
  .grid-card:hover .grid-card-img img {
    transform: scale(1.04);
  }

  .grid-card-body {
    padding: 16px 0 0;
  }

  .grid-card-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(16px, 2vw, 22px);
    font-weight: 600;
    color: #ffffff;
    line-height: 1.3;
  }

  /* ══════════════════ CATEGORY SECTIONS ══════════════════ */
  .sections-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
    margin: 80px 0;
  }

  /* ══════════════════ SPOT BANNER ══════════════════ */
  .spot-banner {
    position: relative;
    margin: 0 calc(-1 * var(--page-pad));
    min-height: 560px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .spot-bg {
    position: absolute;
    inset: 0;
  }

  .spot-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .spot-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(13,27,42,0.7) 0%, rgba(13,27,42,0.75) 100%);
  }

  .spot-content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 80px 24px;
    max-width: 680px;
  }

  .spot-eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 20px;
  }

  .spot-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(30px, 5vw, 52px);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .spot-desc {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 300;
    color: rgba(255,255,255,0.6);
    line-height: 1.7;
    margin-bottom: 40px;
  }

  .spot-cta {
    display: inline-flex;
    align-items: center;
    padding: 16px 40px;
    background: var(--color-gold);
    color: #0D1B2A;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
    border-radius: 4px;
    transition: all var(--transition-fast);
  }
  .spot-cta:hover {
    background: #d9b85c;
    box-shadow: 0 8px 28px rgba(201,168,76,0.4);
    transform: translateY(-2px);
  }

  /* ══════════════════ MEMBERSHIP ══════════════════ */
  .membership-section {
    margin: 96px 0;
  }

  .membership-subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 300;
    color: rgba(255,255,255,0.45);
  }

  .tier-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-top: 48px;
  }

  .tier-card {
    padding: 40px 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: relative;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .tier-card--featured {
    border-top: 2px solid var(--color-gold);
  }

  .tier-name {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .tier-price {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 42px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -1px;
  }

  .tier-period {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: rgba(255,255,255,0.35);
    letter-spacing: 0;
  }

  .tier-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .tier-features li {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: rgba(255,255,255,0.55);
    padding-left: 16px;
    position: relative;
  }
  .tier-features li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-gold);
    font-size: 12px;
  }

  .tier-btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 14px 24px;
    border-radius: 4px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: all var(--transition-fast);
    text-align: center;
    width: 100%;
  }

  .tier-btn--gold {
    background: var(--color-gold);
    color: #0D1B2A;
  }
  .tier-btn--gold:hover {
    background: #d9b85c;
    box-shadow: 0 4px 16px rgba(201,168,76,0.35);
    transform: translateY(-1px);
  }

  .tier-btn--outline {
    border: 1px solid rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.6);
  }
  .tier-btn--outline:hover {
    border-color: var(--color-gold);
    color: var(--color-gold);
    transform: translateY(-1px);
  }

  /* ══════════════════ NEWSLETTER ══════════════════ */
  .newsletter-section {
    margin: 0 0 96px;
    padding: 64px 48px;
    border-top: 1px solid rgba(201,168,76,0.2);
    border-bottom: 1px solid rgba(201,168,76,0.2);
    text-align: center;
  }

  .newsletter-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 12px;
  }

  .newsletter-sub {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 300;
    color: rgba(255,255,255,0.4);
    margin-bottom: 32px;
  }

  .newsletter-form {
    display: flex;
    gap: 10px;
    max-width: 480px;
    margin: 0 auto;
    flex-wrap: wrap;
    justify-content: center;
  }

  .newsletter-input {
    flex: 1;
    min-width: 240px;
    padding: 14px 18px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 4px;
    color: #ffffff;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    outline: none;
    transition: border-color var(--transition-fast);
  }
  .newsletter-input::placeholder { color: rgba(255,255,255,0.25); }
  .newsletter-input:focus { border-color: var(--color-gold); }

  .newsletter-btn {
    padding: 14px 24px;
    background: var(--color-gold);
    color: #0D1B2A;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 700;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
  }
  .newsletter-btn:hover {
    background: #d9b85c;
    box-shadow: 0 4px 16px rgba(201,168,76,0.35);
    transform: translateY(-1px);
  }

  /* ══════════════════ LAST UPDATED ══════════════════ */
  .last-updated {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 24px;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    color: rgba(255,255,255,0.18);
    letter-spacing: 0.3px;
  }
  .last-updated-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-gold);
    animation: pulseGlow 2s ease-in-out infinite;
  }

  /* ══════════════════ RESPONSIVE ══════════════════ */
  @media (min-width: 640px) {
    .grid-articles {
      grid-template-columns: repeat(2, 1fr);
    }
    .tier-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
