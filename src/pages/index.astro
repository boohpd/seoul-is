---
import { getFeatured } from '../lib/content.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const featuredArticles = getFeatured().slice(0, 6);

const categoryColors = {
  kpop: 'pill-kpop',
  kdrama: 'pill-kdrama',
  food: 'pill-food',
  places: 'pill-places',
  travel: 'pill-travel',
};

const weatherData = [
  { city: 'Seoul', temp: '15°C', icon: '🌤', condition: 'Partly Cloudy', outfit: 'Light jacket + layer recommended', img: 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=400&q=80' },
  { city: 'Busan', temp: '18°C', icon: '☀️', condition: 'Sunny', outfit: 'T-shirt weather, bring sunscreen', img: 'https://images.unsplash.com/photo-1469334031218-e382a71b716b?w=400&q=80' },
  { city: 'Jeju', temp: '12°C', icon: '🌧', condition: 'Showers', outfit: 'Waterproof jacket essential', img: 'https://images.unsplash.com/photo-1548036328-c9fa89d128fa?w=400&q=80' },
];

const essentials = [
  { emoji: '💳', title: 'T-Money Card' },
  { emoji: '📱', title: 'Pocket WiFi / eSIM' },
  { emoji: '🏥', title: 'Travel Insurance' },
  { emoji: '💊', title: 'Basic Meds' },
  { emoji: '👟', title: 'Comfortable Shoes' },
  { emoji: '🌂', title: 'Compact Umbrella' },
  { emoji: '🔌', title: 'Universal Adapter' },
  { emoji: '💰', title: 'Korean Won Cash' },
];

const courses = [
  { name: 'Hongdae', tagline: 'Art, music & street vibes', img: 'https://images.unsplash.com/photo-1583623025817-d180a2221d0a?w=600&q=80' },
  { name: 'Gangnam', tagline: 'Luxury, K-pop & nightlife', img: 'https://images.unsplash.com/photo-1601621915196-2621bfb0cd6e?w=600&q=80' },
  { name: 'Insadong', tagline: 'Culture, tea & tradition', img: 'https://images.unsplash.com/photo-1578662996442-48f60103fc96?w=600&q=80' },
  { name: 'Jeju Island', tagline: 'Nature, beaches & volcanic wonder', img: 'https://images.unsplash.com/photo-1548196589-7b30f92b8454?w=600&q=80' },
];

const events = [
  { title: 'Seoul Lantern Festival', days: 12, date: 'Nov 2', location: 'Cheonggyecheon Stream', img: 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=600&q=80' },
  { title: 'K-Pop World Festival', days: 28, date: 'Nov 18', location: 'Olympic Park, Seoul', img: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=600&q=80' },
  { title: 'Busan International Film Festival', days: 45, date: 'Dec 5', location: 'Haeundae, Busan', img: 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=600&q=80' },
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Seoul.is — Seoul Is Where You Belong</title>
  <meta name="description" content="Your ultimate guide to Seoul — K-pop, food, travel, culture and everything in between." />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <Header />

  <!-- LIVE Banner -->
  <div class="live-banner">
    <span class="live-dot"></span>
    <span class="live-label">LIVE</span>
    <div class="ticker-wrap">
      <span class="ticker-text">BTS announces surprise comeback · Gangnam café goes viral · Cherry blossoms peak alert · NewJeans tops global charts · Myeongdong street food festival this weekend · Seoul Fashion Week kicks off ·</span>
    </div>
  </div>

  <!-- HERO -->
  <section class="hero">
    <img class="hero-bg" src="https://images.unsplash.com/photo-1538485399081-7191377e8241?w=1600&q=80" alt="Seoul skyline" loading="eager" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1 class="hero-headline display">Seoul Is Where<br/>You Belong</h1>
      <div class="hero-langs">
        <span>서울에 어서 오세요</span>
        <span>ソウルへようこそ</span>
        <span>首尔欢迎您</span>
        <span>Chào mừng đến Seoul</span>
        <span>ยินดีต้อนรับสู่โซล</span>
        <span>Selamat datang di Seoul</span>
      </div>
      <div class="hero-ctas">
        <a href="/courses" class="btn btn-gold">Explore Seoul →</a>
        <a href="#weather" class="btn btn-outline">🌤 Today's Weather</a>
      </div>
    </div>
  </section>

  <!-- WEATHER -->
  <section class="section" id="weather">
    <h2 class="section-title">🌤 Today's <span>Weather</span> & What to Wear</h2>
    <div class="weather-grid">
      {weatherData.map(w => (
        <div class="weather-card">
          <img src={w.img} alt={w.city} loading="lazy" />
          <div class="weather-body">
            <div class="weather-top">
              <span class="weather-city">{w.city}</span>
              <span class="weather-temp">{w.icon} {w.temp}</span>
            </div>
            <p class="weather-condition">{w.condition}</p>
            <p class="weather-outfit">👗 {w.outfit}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CONTENT GRID -->
  <section class="section reveal">
    <h2 class="section-title">📲 <span>Latest</span> from Seoul</h2>
    <div class="card-grid">
      {featuredArticles.map(article => (
        <a href={article?.url ?? '#'} class="content-card">
          <div class="card-img-wrap">
            <img
              src={article?.heroImage ?? `https://images.unsplash.com/photo-1538485399081-7191377e8241?w=600&q=80`}
              alt={article?.title ?? ''}
              loading="lazy"
              onerror="this.src='https://images.unsplash.com/photo-1538485399081-7191377e8241?w=600&q=80'"
            />
            <span class={`pill ${categoryColors[article?.category] ?? 'pill-places'}`}>{(article?.category ?? 'Seoul').toUpperCase()}</span>
          </div>
          <div class="card-body">
            <h3 class="card-title">{article?.title}</h3>
            <span class="card-meta">{article?.readTime ?? '5 min read'}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ESSENTIALS STRIP -->
  <section class="section reveal">
    <h2 class="section-title">🧳 Korea <span>Essentials</span> for First-Timers</h2>
    <div class="scroll-strip essentials-strip">
      {essentials.map(e => (
        <a href="/essentials" class="essential-card">
          <span class="essential-emoji">{e.emoji}</span>
          <span class="essential-title">{e.title}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- COURSES -->
  <section class="section reveal">
    <h2 class="section-title">🗺 Must-Do <span>Courses</span></h2>
    <div class="courses-grid">
      {courses.map(c => (
        <a href="/courses" class="course-card">
          <img src={c.img} alt={c.name} loading="lazy" />
          <div class="course-overlay">
            <h3 class="course-name">{c.name}</h3>
            <p class="course-tagline">{c.tagline}</p>
            <span class="course-cta">Explore →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CAFÉ BANNER -->
  <section class="cafe-banner reveal">
    <img src="https://images.unsplash.com/photo-1559925393-8be0ec4767c8?w=1400&q=80" alt="SEOULIS Café" loading="lazy" />
    <div class="cafe-overlay">
      <h2 class="cafe-title display">SEOULIS CAFÉ</h2>
      <p class="cafe-sub">Coming to Hongdae 2027</p>
      <p class="cafe-desc">K-culture • Specialty Coffee • Editorial Space</p>
      <a href="/spot/seoulis-cafe" class="btn btn-gold">Join Waitlist →</a>
    </div>
  </section>

  <!-- EVENTS -->
  <section class="section reveal">
    <h2 class="section-title">📅 Upcoming <span>Events</span></h2>
    <div class="events-grid">
      {events.map(ev => (
        <div class="event-card">
          <div class="event-img-wrap">
            <img src={ev.img} alt={ev.title} loading="lazy" />
            <span class="badge-dday">D-{ev.days}</span>
          </div>
          <div class="event-body">
            <p class="event-date">{ev.date}</p>
            <h3 class="event-title">{ev.title}</h3>
            <p class="event-location">📍 {ev.location}</p>
            <a href="/events" class="btn btn-outline" style="margin-top:0.75rem;font-size:0.8rem;">Get Info →</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- LANGUAGE SWITCHER (floating) -->
  <div class="lang-float">
    {['EN','KO','JA','ZH','VI','TH','ID'].map(l => (
      <button class={`lang-float-btn ${l === 'EN' ? 'active' : ''}`} data-lang={l}>{l}</button>
    ))}
  </div>

  <div id="lang-toast"></div>

  <Footer />

  <style>
    /* Live Banner */
    .live-banner {
      background: linear-gradient(90deg, #1a0a10 0%, #1a0012 100%);
      border-bottom: 1px solid var(--red);
      padding: 0.5rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      overflow: hidden;
    }
    .live-label {
      color: var(--red);
      font-size: 0.75rem;
      font-weight: 900;
      letter-spacing: 0.1em;
      flex-shrink: 0;
    }

    /* Hero */
    .hero {
      position: relative;
      height: 100svh;
      min-height: 560px;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(13,27,42,0.97) 0%, rgba(13,27,42,0.4) 60%, transparent 100%);
    }
    .hero-content {
      position: relative;
      z-index: 2;
      padding: 3rem 2rem 4rem;
      max-width: 1200px;
      margin: 0 auto;
      width: 100%;
    }
    .hero-headline {
      font-size: clamp(2.5rem, 7vw, 5.5rem);
      font-weight: 900;
      line-height: 1.05;
      color: var(--white);
      margin-bottom: 1rem;
    }
    .hero-langs {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
      margin-bottom: 1.75rem;
      opacity: 0.7;
      font-size: 0.9rem;
    }
    .hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; }

    /* Weather */
    .weather-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    @media (max-width: 700px) { .weather-grid { grid-template-columns: 1fr; } }
    .weather-card {
      background: var(--card-bg);
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .weather-card img { width: 100%; height: 140px; object-fit: cover; }
    .weather-body { padding: 1rem; }
    .weather-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
    .weather-city { font-weight: 800; font-size: 1.1rem; }
    .weather-temp { font-size: 1.1rem; color: var(--gold); }
    .weather-condition { color: var(--gray); font-size: 0.85rem; margin-bottom: 0.4rem; }
    .weather-outfit { font-size: 0.82rem; color: #aac; }

    /* Content Cards */
    .content-card {
      background: var(--card-bg);
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid var(--border);
      transition: transform 0.25s, border-color 0.25s;
      display: block;
    }
    .content-card:hover { transform: scale(1.02); border-color: var(--gold); }
    .card-img-wrap { position: relative; aspect-ratio: 16/9; overflow: hidden; }
    .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
    .content-card:hover .card-img-wrap img { transform: scale(1.05); }
    .card-img-wrap .pill { position: absolute; top: 10px; left: 10px; }
    .card-body { padding: 0.9rem 1rem; }
    .card-title { font-size: 0.92rem; font-weight: 700; line-height: 1.35; margin-bottom: 0.4rem; color: var(--white); font-family: var(--font-body); }
    .card-meta { color: var(--gray); font-size: 0.78rem; }

    /* Essentials */
    .essentials-strip { padding-bottom: 0.5rem; }
    .essential-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.25rem 1.5rem;
      min-width: 130px;
      flex-shrink: 0;
      transition: border-color 0.2s, background 0.2s;
      text-align: center;
    }
    .essential-card:hover { border-color: var(--gold); background: rgba(201,168,76,0.08); }
    .essential-emoji { font-size: 2rem; }
    .essential-title { font-size: 0.8rem; font-weight: 600; color: var(--white); }

    /* Courses */
    .courses-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    @media (max-width: 900px) { .courses-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 500px) { .courses-grid { grid-template-columns: 1fr; } }
    .course-card {
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      aspect-ratio: 3/4;
      display: block;
    }
    .course-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
    .course-card:hover img { transform: scale(1.06); }
    .course-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 50%);
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 1.25rem;
    }
    .course-name { font-size: 1.2rem; font-weight: 900; }
    .course-tagline { font-size: 0.78rem; color: rgba(255,255,255,0.75); margin: 0.2rem 0 0.6rem; }
    .course-cta { color: var(--gold); font-size: 0.82rem; font-weight: 700; }

    /* Café Banner */
    .cafe-banner {
      position: relative;
      height: 400px;
      overflow: hidden;
      margin: 0 0 1rem;
    }
    .cafe-banner img { width: 100%; height: 100%; object-fit: cover; }
    .cafe-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, rgba(13,27,42,0.9) 0%, rgba(13,27,42,0.4) 100%);
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 3rem;
    }
    .cafe-title { font-size: clamp(1.8rem, 4vw, 3rem); color: var(--gold); margin-bottom: 0.25rem; }
    .cafe-sub { font-size: 1rem; color: var(--white); margin-bottom: 0.25rem; }
    .cafe-desc { color: var(--gray); font-size: 0.9rem; margin-bottom: 1.25rem; }

    /* Events */
    .events-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
    @media (max-width: 800px) { .events-grid { grid-template-columns: 1fr; } }
    .event-card {
      background: var(--card-bg);
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .event-img-wrap { position: relative; }
    .event-img-wrap img { width: 100%; height: 180px; object-fit: cover; }
    .event-img-wrap .badge-dday { position: absolute; top: 10px; right: 10px; }
    .event-body { padding: 1rem 1.25rem 1.25rem; }
    .event-date { color: var(--gold); font-size: 0.8rem; font-weight: 700; margin-bottom: 0.3rem; }
    .event-title { font-size: 1rem; font-weight: 800; margin-bottom: 0.3rem; font-family: var(--font-body); }
    .event-location { color: var(--gray); font-size: 0.82rem; }

    /* Lang Float */
    .lang-float {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 6px;
      z-index: 500;
    }
    .lang-float-btn {
      background: var(--card-bg);
      border: 1px solid var(--border);
      color: var(--gray);
      font-size: 0.72rem;
      font-weight: 700;
      padding: 5px 10px;
      border-radius: 999px;
      transition: all 0.2s;
    }
    .lang-float-btn.active, .lang-float-btn:hover {
      background: var(--gold);
      color: #000;
      border-color: var(--gold);
    }
  </style>

  <script>
    // Scroll Reveal
    const reveals = document.querySelectorAll('.reveal');
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
    }, { threshold: 0.1 });
    reveals.forEach(el => obs.observe(el));

    // Lang float
    function showToast(msg) {
      let t = document.getElementById('lang-toast');
      if (!t) { t = document.createElement('div'); t.id = 'lang-toast'; document.body.appendChild(t); }
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2500);
    }
    document.querySelectorAll('.lang-float-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.lang-float-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const lang = btn.dataset.lang;
        if (lang !== 'EN') showToast(`Coming soon in ${lang}!`);
      });
    });
  </script>
</body>
</html>
