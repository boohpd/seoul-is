---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ContentCard from '../components/ContentCard.astro';
import CategorySection from '../components/CategorySection.astro';
import Footer from '../components/Footer.astro';
import { getAllContent, getFeatured, getMeta } from '../lib/content.js';
import { getAllArticleSlugs, getTravelArticle } from '../lib/articles.js';
import { CATEGORIES, CAT_ORDER } from '../lib/categories.js';

const content = getAllContent();
const meta = getMeta();

// Featured articles: pick up to 6 across categories
const allArticleSlugs = getAllArticleSlugs().slice(0, 6);
const featuredArticles = allArticleSlugs.map(slug => getTravelArticle(slug)).filter(Boolean);
---

<Base>
  <Header />

  <main class="main-content">

    <!-- ═══ HERO SECTION ═══ -->
    <section class="hero animate-fade-in">
      <div class="hero-bg"></div>
      <div class="hero-glow"></div>
      <div class="hero-content">
        <div class="hero-eyebrow">✦ K-CULTURE EDITORIAL</div>
        <h1 class="hero-title">Seoul Is Where<br/>You Belong</h1>
        <p class="hero-sub">Your daily guide to K-culture, curated from 50+ sources in 8 languages</p>
        <div class="hero-ctas">
          <a href="/articles" class="hero-btn hero-btn--outline">Explore Articles</a>
          <a href="/membership" class="hero-btn hero-btn--gold">Join Seoul Prime Club</a>
        </div>
      </div>
    </section>

    <!-- ═══ LIVE TICKER ═══ -->
    <div class="ticker-wrapper animate-fade-in">
      <div class="ticker-inner">
        <div class="ticker-track">
          <span class="ticker-text">✦ K-POP · K-DRAMA · FOOD · HOT PLACES · LIFESTYLE · TRAVEL ✦ K-POP · K-DRAMA · FOOD · HOT PLACES · LIFESTYLE · TRAVEL ✦ K-POP · K-DRAMA · FOOD · HOT PLACES · LIFESTYLE · TRAVEL ✦ K-POP · K-DRAMA · FOOD · HOT PLACES · LIFESTYLE · TRAVEL &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
          <span class="ticker-text">✦ K-POP · K-DRAMA · FOOD · HOT PLACES · LIFESTYLE · TRAVEL ✦ K-POP · K-DRAMA · FOOD · HOT PLACES · LIFESTYLE · TRAVEL ✦ K-POP · K-DRAMA · FOOD · HOT PLACES · LIFESTYLE · TRAVEL ✦ K-POP · K-DRAMA · FOOD · HOT PLACES · LIFESTYLE · TRAVEL &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>
        </div>
      </div>
    </div>

    <!-- ═══ STATS BAR ═══ -->
    <section class="stats-bar animate-fade-in delay-1">
      <div class="stats-inner">
        <div class="stat-item">
          <span class="stat-number">50+</span>
          <span class="stat-label">Sources</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">8</span>
          <span class="stat-label">Languages</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">8</span>
          <span class="stat-label">Categories</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">Daily</span>
          <span class="stat-label">Updates</span>
        </div>
      </div>
    </section>

    <!-- ═══ FEATURED ARTICLES GRID ═══ -->
    {featuredArticles.length > 0 && (
      <section class="featured-section animate-fade-in delay-2">
        <div class="section-header">
          <h2 class="section-title">Featured Articles</h2>
          <a href="/articles" class="section-link">View All →</a>
        </div>
        <div class="featured-grid">
          {featuredArticles.map(article => (
            <a href={`/article/${article.slug}`} class="article-card card-hover-gold">
              {article.heroImage && (
                <div class="article-card-img">
                  <img src={article.heroImage} alt={article.title} loading="lazy" />
                </div>
              )}
              <div class="article-card-body">
                <span class="article-card-cat">{article.category}</span>
                <h3 class="article-card-title">{article.title}</h3>
                {article.description && (
                  <p class="article-card-desc">{article.description}</p>
                )}
                <div class="article-card-meta">
                  <span>{article.readTime}</span>
                  {article.date && <span>{new Date(article.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>}
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ═══ CATEGORY SECTIONS ═══ -->
    <div class="sections-wrapper">
      {CAT_ORDER.map((catId, index) => (
        <div class="section-block">
          <CategorySection categoryId={catId} items={content[catId] || []} />
        </div>
      ))}
    </div>

    <!-- ═══ SEOULIS SPOT BANNER ═══ -->
    <section class="spot-banner animate-fade-in">
      <div class="spot-bg"></div>
      <div class="spot-content">
        <div class="spot-tag">SEOULIS SPOT</div>
        <h2 class="spot-title">Transform Your Café Into a SEOULIS SPOT</h2>
        <p class="spot-desc">Get featured in Seoul's most curated editorial platform. Connect with K-culture lovers worldwide.</p>
        <div class="spot-zones">
          <div class="zone-icon">☕<span>Café</span></div>
          <div class="zone-icon">🍽️<span>Dining</span></div>
          <div class="zone-icon">🎵<span>Culture</span></div>
          <div class="zone-icon">🛍️<span>Shopping</span></div>
          <div class="zone-icon">🏨<span>Stay</span></div>
        </div>
        <a href="/spot" class="spot-cta">Apply Now →</a>
      </div>
    </section>

    <!-- ═══ SEOUL PRIME CLUB ═══ -->
    <section class="membership-section animate-fade-in">
      <div class="section-header section-header--center">
        <h2 class="section-title">Seoul Prime Club</h2>
        <p class="membership-subtitle">Choose your level of access to the Seoul you've always wanted</p>
      </div>
      <div class="tier-grid">
        <!-- FREE -->
        <div class="tier-card card-hover-gold">
          <div class="tier-name">FREE</div>
          <div class="tier-price">₩0<span class="tier-period">/month</span></div>
          <ul class="tier-features">
            <li>✓ Daily K-culture news</li>
            <li>✓ Articles in 8 languages</li>
            <li>✓ Basic neighborhood guides</li>
            <li>✓ Community access</li>
          </ul>
          <a href="/membership" class="tier-btn tier-btn--outline">Get Started</a>
        </div>

        <!-- SEOUL PASS -->
        <div class="tier-card card-hover-gold tier-card--featured">
          <div class="badge-recommended">Recommended</div>
          <div class="tier-name">SEOUL PASS</div>
          <div class="tier-price">₩9,900<span class="tier-period">/month</span></div>
          <ul class="tier-features">
            <li>✓ Everything in Free</li>
            <li>✓ Exclusive SPOT discounts</li>
            <li>✓ Priority article access</li>
            <li>✓ Monthly Seoul insider briefing</li>
            <li>✓ Ad-free experience</li>
          </ul>
          <a href="/membership" class="tier-btn tier-btn--gold">Join Now</a>
        </div>

        <!-- SEOUL PRIME -->
        <div class="tier-card card-hover-gold">
          <div class="tier-name">SEOUL PRIME</div>
          <div class="tier-price">₩29,900<span class="tier-period">/month</span></div>
          <ul class="tier-features">
            <li>✓ Everything in Seoul Pass</li>
            <li>✓ Private Telegram community</li>
            <li>✓ VIP SPOT reservations</li>
            <li>✓ 1-on-1 Seoul concierge</li>
            <li>✓ Exclusive events & meetups</li>
          </ul>
          <a href="/membership" class="tier-btn tier-btn--outline">Join Now</a>
        </div>
      </div>
    </section>

    <!-- ═══ NEWSLETTER ═══ -->
    <section class="newsletter-section animate-fade-in">
      <div class="newsletter-content">
        <h2 class="newsletter-title">Get Seoul's Best Weekly</h2>
        <p class="newsletter-sub">Curated K-culture highlights, delivered every Monday morning.</p>
        <form class="newsletter-form" action="mailto:hello@seoul.is" method="get">
          <input type="email" name="subject" placeholder="Your email address" class="newsletter-input" required />
          <button type="submit" class="newsletter-btn">Subscribe →</button>
        </form>
      </div>
    </section>

    <!-- ═══ LAST UPDATED ═══ -->
    {meta.lastUpdated && (
      <div class="last-updated">
        <span class="last-updated-dot"></span>
        Last updated: {new Date(meta.lastUpdated).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })}
      </div>
    )}

  </main>

  <Footer />
</Base>

<style>
  /* ─── Main content ─── */
  .main-content {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--page-pad);
  }

  /* ═══════════════════════════
     HERO
     ═══════════════════════════ */
  .hero {
    position: relative;
    margin: 0 calc(-1 * var(--page-pad));
    padding: 100px var(--page-pad) 80px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 520px;
    background: var(--color-bg);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 60% 50%, rgba(201, 168, 76, 0.08) 0%, transparent 60%),
                radial-gradient(ellipse at 20% 80%, rgba(20, 41, 64, 0.6) 0%, transparent 50%);
  }

  .hero-glow {
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    background: radial-gradient(ellipse at right center, rgba(201, 168, 76, 0.06) 0%, transparent 70%);
  }

  .hero-content {
    position: relative;
    text-align: center;
    max-width: 700px;
    z-index: 1;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 24px;
    padding: 6px 16px;
    border: 1px solid rgba(201, 168, 76, 0.3);
    border-radius: 20px;
    background: rgba(201, 168, 76, 0.06);
  }

  .hero-title {
    font-size: clamp(40px, 8vw, 72px);
    font-weight: 900;
    letter-spacing: -2px;
    line-height: 1.05;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .hero-sub {
    font-size: clamp(15px, 2.5vw, 18px);
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
    max-width: 500px;
    margin: 0 auto 36px;
  }

  .hero-ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    padding: 14px 28px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.2px;
    transition: all var(--transition-fast);
  }

  .hero-btn--outline {
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.04);
  }
  .hero-btn--outline:hover {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
  }

  .hero-btn--gold {
    background: var(--color-gold);
    color: #0D1B2A;
  }
  .hero-btn--gold:hover {
    background: #d9b85c;
    box-shadow: 0 6px 24px rgba(201, 168, 76, 0.4);
    transform: translateY(-2px);
  }

  /* ═══════════════════════════
     TICKER
     ═══════════════════════════ */
  .ticker-wrapper {
    margin: 0 calc(-1 * var(--page-pad));
    overflow: hidden;
    background: var(--color-dark2);
    border-top: 1px solid rgba(201, 168, 76, 0.15);
    border-bottom: 1px solid rgba(201, 168, 76, 0.15);
    padding: 12px 0;
  }

  .ticker-inner {
    overflow: hidden;
    white-space: nowrap;
  }

  .ticker-track {
    display: inline-flex;
    animation: ticker-scroll 30s linear infinite;
  }
  .ticker-track:hover { animation-play-state: paused; }

  .ticker-text {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-gold);
    padding-right: 0;
  }

  /* ═══════════════════════════
     STATS BAR
     ═══════════════════════════ */
  .stats-bar {
    margin: 48px 0;
  }

  .stats-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
    background: var(--color-dark2);
    border: 1px solid rgba(201, 168, 76, 0.15);
    border-radius: var(--radius-lg);
    padding: 28px 32px;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 32px;
  }

  .stat-number {
    font-size: 28px;
    font-weight: 900;
    color: var(--color-gold);
    letter-spacing: -0.5px;
  }

  .stat-label {
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 4px;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: rgba(201, 168, 76, 0.15);
    flex-shrink: 0;
  }

  /* ═══════════════════════════
     SECTION HEADER
     ═══════════════════════════ */
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .section-header--center {
    flex-direction: column;
    text-align: center;
    gap: 8px;
    margin-bottom: 36px;
  }

  .section-title {
    font-size: 22px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.3px;
  }

  .section-link {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-gold);
    transition: opacity var(--transition-fast);
  }
  .section-link:hover { opacity: 0.7; }

  /* ═══════════════════════════
     FEATURED ARTICLES
     ═══════════════════════════ */
  .featured-section {
    margin: 56px 0;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    background: var(--color-dark2);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .article-card-img {
    height: 180px;
    overflow: hidden;
    background: #0f1e30;
  }
  .article-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }
  .article-card:hover .article-card-img img {
    transform: scale(1.04);
  }

  .article-card-body {
    padding: 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .article-card-cat {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-gold);
  }

  .article-card-title {
    font-size: 15px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.4;
  }

  .article-card-desc {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.5;
    flex: 1;
  }

  .article-card-meta {
    display: flex;
    gap: 10px;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.3);
    margin-top: 8px;
  }

  /* ═══════════════════════════
     CATEGORY SECTIONS
     ═══════════════════════════ */
  .sections-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
    margin: 56px 0;
  }

  /* ═══════════════════════════
     SPOT BANNER
     ═══════════════════════════ */
  .spot-banner {
    margin: 56px 0;
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid rgba(201, 168, 76, 0.2);
  }

  .spot-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0D1B2A 0%, #142940 50%, #0D1B2A 100%);
  }

  .spot-content {
    position: relative;
    padding: 52px 40px;
    text-align: center;
  }

  .spot-tag {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-gold);
    border: 1px solid rgba(201, 168, 76, 0.4);
    padding: 4px 14px;
    border-radius: 20px;
    background: rgba(201, 168, 76, 0.06);
    margin-bottom: 20px;
  }

  .spot-title {
    font-size: clamp(22px, 4vw, 36px);
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.5px;
    margin-bottom: 12px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .spot-desc {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 32px;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .spot-zones {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }

  .zone-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: 28px;
  }
  .zone-icon span {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: rgba(255, 255, 255, 0.4);
  }

  .spot-cta {
    display: inline-flex;
    align-items: center;
    padding: 14px 36px;
    background: var(--color-gold);
    color: #0D1B2A;
    font-size: 15px;
    font-weight: 800;
    border-radius: 10px;
    letter-spacing: 0.3px;
    transition: all var(--transition-fast);
  }
  .spot-cta:hover {
    background: #d9b85c;
    box-shadow: 0 6px 24px rgba(201, 168, 76, 0.4);
    transform: translateY(-2px);
  }

  /* ═══════════════════════════
     MEMBERSHIP TIERS
     ═══════════════════════════ */
  .membership-section {
    margin: 56px 0;
  }

  .membership-subtitle {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.5);
    max-width: 500px;
    margin: 0 auto;
  }

  .tier-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 36px;
  }

  .tier-card {
    background: var(--color-dark2);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: relative;
  }

  .tier-card--featured {
    border-color: var(--color-gold);
    background: linear-gradient(135deg, #142940, #0f2235);
    box-shadow: 0 0 40px rgba(201, 168, 76, 0.08);
  }

  .tier-name {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .tier-price {
    font-size: 36px;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -1px;
  }

  .tier-period {
    font-size: 14px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0;
  }

  .tier-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .tier-features li {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.65);
  }

  .tier-btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 13px 24px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    transition: all var(--transition-fast);
    text-align: center;
  }

  .tier-btn--gold {
    background: var(--color-gold);
    color: #0D1B2A;
  }
  .tier-btn--gold:hover {
    background: #d9b85c;
    box-shadow: 0 4px 16px rgba(201, 168, 76, 0.4);
    transform: translateY(-1px);
  }

  .tier-btn--outline {
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.7);
  }
  .tier-btn--outline:hover {
    border-color: var(--color-gold);
    color: var(--color-gold);
    transform: translateY(-1px);
  }

  /* ═══════════════════════════
     NEWSLETTER
     ═══════════════════════════ */
  .newsletter-section {
    margin: 56px 0;
    background: var(--color-dark2);
    border: 1px solid rgba(201, 168, 76, 0.15);
    border-radius: var(--radius-xl);
    padding: 52px 40px;
    text-align: center;
  }

  .newsletter-title {
    font-size: 28px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.5px;
    margin-bottom: 10px;
  }

  .newsletter-sub {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 28px;
  }

  .newsletter-form {
    display: flex;
    gap: 10px;
    max-width: 480px;
    margin: 0 auto;
    flex-wrap: wrap;
    justify-content: center;
  }

  .newsletter-input {
    flex: 1;
    min-width: 240px;
    padding: 13px 18px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #ffffff;
    font-size: 14px;
    outline: none;
    transition: border-color var(--transition-fast);
  }
  .newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }
  .newsletter-input:focus {
    border-color: var(--color-gold);
  }

  .newsletter-btn {
    padding: 13px 24px;
    background: var(--color-gold);
    color: #0D1B2A;
    font-size: 14px;
    font-weight: 700;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all var(--transition-fast);
