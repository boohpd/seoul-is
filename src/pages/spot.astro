---
import Base from '../layouts/Base.astro';
---
<Base title="SEOULIS SPOT — Partner Your Café with Seoul.is" description="Transform your café into a SEOULIS SPOT. Join the K-culture community hub network in Seoul. 100% drink revenue stays with you.">
  <div style="background:#0D1B2A;min-height:100vh;color:#fff;">

    <!-- HERO -->
    <section style="max-width:960px;margin:0 auto;padding:80px 24px 60px;text-align:center;">
      <div style="display:inline-block;background:rgba(201,168,76,0.15);border:1px solid rgba(201,168,76,0.4);border-radius:20px;padding:6px 18px;margin-bottom:24px;">
        <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#C9A84C;">Partnership Program</span>
      </div>
      <h1 style="font-size:clamp(2rem,5vw,3.5rem);font-weight:900;line-height:1.15;margin-bottom:20px;">
        Transform Your Café into a<br/><span style="color:#C9A84C;">SEOULIS SPOT</span>
      </h1>
      <p style="font-size:1.15rem;line-height:1.8;color:rgba(255,255,255,0.65);max-width:620px;margin:0 auto 40px;">
        Join Seoul's emerging K-culture community hub network. Attract international K-culture fans, create new revenue streams, and become part of the SEOULIS story — all at zero royalty cost.
      </p>
      <a href="mailto:hello@seoul.is?subject=SEOULIS SPOT Application" style="display:inline-block;background:#C9A84C;color:#0D1B2A;font-weight:800;font-size:1rem;padding:16px 36px;border-radius:12px;text-decoration:none;letter-spacing:0.3px;transition:opacity 0.2s;">
        Apply for SPOT → hello@seoul.is
      </a>
    </section>

    <!-- NO ROYALTY BANNER -->
    <section style="background:rgba(201,168,76,0.1);border-top:1px solid rgba(201,168,76,0.2);border-bottom:1px solid rgba(201,168,76,0.2);padding:24px;text-align:center;margin-bottom:72px;">
      <p style="font-size:1.1rem;font-weight:700;color:#C9A84C;margin:0;">
        ✦ No royalty fee. Owners keep 100% of drink revenue. ✦
      </p>
    </section>

    <!-- 5 ZONES -->
    <section style="max-width:960px;margin:0 auto;padding:0 24px 80px;">
      <h2 style="font-size:1.8rem;font-weight:900;text-align:center;margin-bottom:12px;">The 5 SEOULIS SPOT Zones</h2>
      <p style="color:rgba(255,255,255,0.55);text-align:center;margin-bottom:48px;">Each SPOT is designed to create community, revenue, and cultural connection.</p>

      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:24px;">

        <!-- DRINK -->
        <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(201,168,76,0.25);border-radius:16px;padding:28px;">
          <div style="font-size:2rem;margin-bottom:12px;">☕</div>
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:#C9A84C;margin-bottom:8px;">Zone 01</div>
          <h3 style="font-size:1.2rem;font-weight:800;margin-bottom:12px;">DRINK</h3>
          <p style="color:rgba(255,255,255,0.6);line-height:1.7;font-size:0.95rem;">Your café, your menu, your identity — the SEOULIS SPOT brand brings global K-culture fans through your door. You keep <strong style="color:#C9A84C;">100% of all drink revenue</strong>, always.</p>
        </div>

        <!-- AI PHOTO -->
        <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(201,168,76,0.25);border-radius:16px;padding:28px;">
          <div style="font-size:2rem;margin-bottom:12px;">📸</div>
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:#C9A84C;margin-bottom:8px;">Zone 02</div>
          <h3 style="font-size:1.2rem;font-weight:800;margin-bottom:12px;">AI PHOTO</h3>
          <p style="color:rgba(255,255,255,0.6);line-height:1.7;font-size:0.95rem;">An AI photo booth where visitors generate Korean-style portrait photos to share. Priced at <strong style="color:#fff;">₩3,000–8,000</strong> per session. Drives social sharing and foot traffic.</p>
        </div>

        <!-- COMMUNITY BOARD -->
        <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(201,168,76,0.25);border-radius:16px;padding:28px;">
          <div style="font-size:2rem;margin-bottom:12px;">🪧</div>
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:#C9A84C;margin-bottom:8px;">Zone 03</div>
          <h3 style="font-size:1.2rem;font-weight:800;margin-bottom:12px;">COMMUNITY BOARD</h3>
          <p style="color:rgba(255,255,255,0.6);line-height:1.7;font-size:0.95rem;">NFC-enabled digital community board where visitors exchange smart business cards, post events, and find travel partners. The modern bulletin board for K-culture explorers.</p>
        </div>

        <!-- COMMERCE -->
        <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(201,168,76,0.25);border-radius:16px;padding:28px;">
          <div style="font-size:2rem;margin-bottom:12px;">🛍️</div>
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:#C9A84C;margin-bottom:8px;">Zone 04</div>
          <h3 style="font-size:1.2rem;font-weight:800;margin-bottom:12px;">COMMERCE</h3>
          <p style="color:rgba(255,255,255,0.6);line-height:1.7;font-size:0.95rem;">K-beauty product samples from <strong style="color:#fff;">₩100</strong>. A curated micro-retail shelf brings authentic Korean skincare and beauty to your customers while they enjoy their coffee.</p>
        </div>

        <!-- CONNECT LOUNGE -->
        <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(201,168,76,0.25);border-radius:16px;padding:28px;">
          <div style="font-size:2rem;margin-bottom:12px;">🌏</div>
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.2px;color:#C9A84C;margin-bottom:8px;">Zone 05</div>
          <h3 style="font-size:1.2rem;font-weight:800;margin-bottom:12px;">CONNECT LOUNGE</h3>
          <p style="color:rgba(255,255,255,0.6);line-height:1.7;font-size:0.95rem;">A designated corner for community events — language exchanges, K-pop listening sessions, travel meetups. Transform your space into a genuine cultural meeting point.</p>
        </div>

      </div>
    </section>

    <!-- MEMBERSHIP TIERS -->
    <section style="max-width:960px;margin:0 auto;padding:0 24px 80px;">
      <h2 style="font-size:1.8rem;font-weight:900;text-align:center;margin-bottom:12px;">SEOULIS Membership Tiers</h2>
      <p style="color:rgba(255,255,255,0.55);text-align:center;margin-bottom:48px;">SPOT visitors get access to the SEOULIS membership ecosystem.</p>

      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:20px;">

        <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:24px;text-align:center;">
          <div style="font-size:1.5rem;margin-bottom:12px;">🆓</div>
          <h3 style="font-weight:800;margin-bottom:8px;">FREE</h3>
          <p style="font-size:1.5rem;font-weight:900;color:#C9A84C;margin-bottom:12px;">₩0</p>
          <p style="font-size:12px;color:rgba(255,255,255,0.5);line-height:1.6;">Access to SEOULIS content, SPOT check-in, community board</p>
        </div>

        <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:24px;text-align:center;">
          <div style="font-size:1.5rem;margin-bottom:12px;">🎫</div>
          <h3 style="font-weight:800;margin-bottom:8px;">SEOUL PASS</h3>
          <p style="font-size:1.5rem;font-weight:900;color:#C9A84C;margin-bottom:4px;">₩9,900<span style="font-size:0.75rem;font-weight:400;color:rgba(255,255,255,0.4)">/mo</span></p>
          <p style="font-size:12px;color:rgba(255,255,255,0.5);line-height:1.6;margin-top:12px;">AI Photo sessions, K-beauty sample discounts, priority event access</p>
        </div>

        <div style="background:rgba(201,168,76,0.08);border:2px solid rgba(201,168,76,0.5);border-radius:16px;padding:24px;text-align:center;position:relative;">
          <div style="position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:#C9A84C;color:#0D1B2A;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;padding:4px 12px;border-radius:20px;">Recommended</div>
          <div style="font-size:1.5rem;margin-bottom:12px;">⭐</div>
          <h3 style="font-weight:800;margin-bottom:8px;">SEOUL PRIME</h3>
          <p style="font-size:1.5rem;font-weight:900;color:#C9A84C;margin-bottom:4px;">₩29,900<span style="font-size:0.75rem;font-weight:400;color:rgba(255,255,255,0.4)">/mo</span></p>
          <p style="font-size:12px;color:rgba(255,255,255,0.5);line-height:1.6;margin-top:12px;">All PASS benefits + exclusive events, Seoul Prime lounge access, NFC card, member badge</p>
        </div>

        <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:24px;text-align:center;">
          <div style="font-size:1.5rem;margin-bottom:12px;">🏢</div>
          <h3 style="font-weight:800;margin-bottom:8px;">Corporate</h3>
          <p style="font-size:1.5rem;font-weight:900;color:#C9A84C;margin-bottom:4px;">₩500,000<span style="font-size:0.75rem;font-weight:400;color:rgba(255,255,255,0.4)">+/mo</span></p>
          <p style="font-size:12px;color:rgba(255,255,255,0.5);line-height:1.6;margin-top:12px;">Brand placement, co-hosted events, editorial partnership, custom integration</p>
        </div>

      </div>
    </section>

    <!-- FINAL CTA -->
    <section style="text-align:center;padding:0 24px 100px;">
      <h2 style="font-size:2rem;font-weight:900;margin-bottom:16px;">Ready to become a SEOULIS SPOT?</h2>
      <p style="color:rgba(255,255,255,0.55);margin-bottom:36px;max-width:480px;margin-left:auto;margin-right:auto;line-height:1.7;">
        We're accepting applications from cafés, study spaces, and creative venues in Seoul. No royalty fees. Zero risk.
      </p>
      <a href="mailto:hello@seoul.is?subject=SEOULIS SPOT Application" style="display:inline-block;background:#C9A84C;color:#0D1B2A;font-weight:800;font-size:1rem;padding:16px 40px;border-radius:12px;text-decoration:none;">
        Apply for SPOT → hello@seoul.is
      </a>
    </section>

  </div>
</Base>
