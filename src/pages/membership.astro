---
import Base from '../layouts/Base.astro';
---
<Base title="Seoul Prime Club — SEOULIS Membership" description="Join the Seoul Prime Club. Access exclusive K-culture content, SEOULIS SPOT perks, community events, and more. 4 tiers starting free.">
  <div style="background:#0D1B2A;min-height:100vh;color:#fff;">

    <!-- HERO -->
    <section style="max-width:900px;margin:0 auto;padding:80px 24px 60px;text-align:center;">
      <div style="display:inline-block;background:rgba(201,168,76,0.15);border:1px solid rgba(201,168,76,0.4);border-radius:20px;padding:6px 18px;margin-bottom:24px;">
        <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#C9A84C;">Membership</span>
      </div>
      <h1 style="font-size:clamp(2rem,5vw,3.2rem);font-weight:900;line-height:1.15;margin-bottom:20px;">
        Seoul Prime Club
      </h1>
      <p style="font-size:1.1rem;line-height:1.8;color:rgba(255,255,255,0.6);max-width:560px;margin:0 auto;">
        Unlock deeper access to Seoul's K-culture scene. From curated content to real-world SEOULIS SPOT privileges, choose the membership tier that fits your Seoul journey.
      </p>
    </section>

    <!-- TIERS -->
    <section style="max-width:1000px;margin:0 auto;padding:0 24px 80px;">
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:24px;align-items:start;">

        <!-- FREE -->
        <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.1);border-radius:20px;padding:32px 24px;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🆓</div>
          <h2 style="font-size:1.3rem;font-weight:900;margin-bottom:8px;">FREE</h2>
          <p style="font-size:2.5rem;font-weight:900;color:#C9A84C;margin-bottom:4px;">₩0</p>
          <p style="font-size:13px;color:rgba(255,255,255,0.4);margin-bottom:28px;">Always free</p>
          <ul style="list-style:none;padding:0;margin:0 0 32px;display:flex;flex-direction:column;gap:12px;">
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Full access to seoul.is content</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> SEOULIS SPOT check-in</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Community board access</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Newsletter subscription</li>
          </ul>
          <a href="mailto:hello@seoul.is?subject=Free Membership" style="display:block;text-align:center;border:1px solid rgba(255,255,255,0.2);color:rgba(255,255,255,0.6);padding:12px;border-radius:10px;text-decoration:none;font-weight:700;font-size:14px;">Join Free</a>
        </div>

        <!-- SEOUL PASS -->
        <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.1);border-radius:20px;padding:32px 24px;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🎫</div>
          <h2 style="font-size:1.3rem;font-weight:900;margin-bottom:8px;">SEOUL PASS</h2>
          <p style="font-size:2.5rem;font-weight:900;color:#C9A84C;margin-bottom:4px;">₩9,900</p>
          <p style="font-size:13px;color:rgba(255,255,255,0.4);margin-bottom:28px;">per month</p>
          <ul style="list-style:none;padding:0;margin:0 0 32px;display:flex;flex-direction:column;gap:12px;">
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Everything in FREE</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> AI Photo SPOT sessions (discounted)</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> K-beauty sample discounts</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Priority event access</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Member-only content drops</li>
          </ul>
          <a href="mailto:hello@seoul.is?subject=Seoul Pass Membership" style="display:block;text-align:center;background:rgba(201,168,76,0.15);border:1px solid rgba(201,168,76,0.4);color:#C9A84C;padding:12px;border-radius:10px;text-decoration:none;font-weight:700;font-size:14px;">Join Seoul Pass</a>
        </div>

        <!-- SEOUL PRIME -->
        <div style="background:rgba(201,168,76,0.07);border:2px solid rgba(201,168,76,0.5);border-radius:20px;padding:32px 24px;position:relative;">
          <div style="position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:#C9A84C;color:#0D1B2A;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;padding:5px 16px;border-radius:20px;white-space:nowrap;">⭐ Recommended</div>
          <div style="font-size:2.5rem;margin-bottom:16px;">⭐</div>
          <h2 style="font-size:1.3rem;font-weight:900;margin-bottom:8px;">SEOUL PRIME</h2>
          <p style="font-size:2.5rem;font-weight:900;color:#C9A84C;margin-bottom:4px;">₩29,900</p>
          <p style="font-size:13px;color:rgba(255,255,255,0.4);margin-bottom:28px;">per month</p>
          <ul style="list-style:none;padding:0;margin:0 0 32px;display:flex;flex-direction:column;gap:12px;">
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Everything in SEOUL PASS</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Unlimited AI Photo SPOT sessions</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Exclusive Seoul Prime lounge access</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> SEOULIS NFC smart card</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Member badge & verified profile</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Early access to events & collab drops</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Quarterly Seoul insider guide</li>
          </ul>
          <a href="mailto:hello@seoul.is?subject=Seoul Prime Membership" style="display:block;text-align:center;background:#C9A84C;color:#0D1B2A;padding:14px;border-radius:10px;text-decoration:none;font-weight:800;font-size:14px;">Join Seoul Prime</a>
        </div>

        <!-- CORPORATE -->
        <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.1);border-radius:20px;padding:32px 24px;">
          <div style="font-size:2.5rem;margin-bottom:16px;">🏢</div>
          <h2 style="font-size:1.3rem;font-weight:900;margin-bottom:8px;">Corporate</h2>
          <p style="font-size:2.5rem;font-weight:900;color:#C9A84C;margin-bottom:4px;">₩500,000<span style="font-size:1rem;font-weight:400;">+</span></p>
          <p style="font-size:13px;color:rgba(255,255,255,0.4);margin-bottom:28px;">per month</p>
          <ul style="list-style:none;padding:0;margin:0 0 32px;display:flex;flex-direction:column;gap:12px;">
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Everything in SEOUL PRIME</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Brand placement across SEOULIS</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Co-hosted events & activations</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Editorial partnership opportunities</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Custom SEOULIS SPOT integration</li>
            <li style="font-size:13px;color:rgba(255,255,255,0.65);display:flex;gap:10px;"><span style="color:#C9A84C;">✓</span> Dedicated account manager</li>
          </ul>
          <a href="mailto:hello@seoul.is?subject=Corporate Membership Inquiry" style="display:block;text-align:center;border:1px solid rgba(255,255,255,0.2);color:rgba(255,255,255,0.6);padding:12px;border-radius:10px;text-decoration:none;font-weight:700;font-size:14px;">Contact Us</a>
        </div>

      </div>
    </section>

    <!-- FAQ / NOTE -->
    <section style="max-width:700px;margin:0 auto;padding:0 24px 80px;text-align:center;">
      <h2 style="font-size:1.5rem;font-weight:900;margin-bottom:16px;">Questions?</h2>
      <p style="color:rgba(255,255,255,0.55);line-height:1.8;margin-bottom:24px;">
        Membership management and payment setup are handled manually while we build out our self-service portal. Email us and we'll get you set up within 24 hours.
      </p>
      <a href="mailto:hello@seoul.is?subject=Membership Question" style="color:#C9A84C;font-weight:700;text-decoration:none;">hello@seoul.is →</a>
    </section>

  </div>
</Base>
