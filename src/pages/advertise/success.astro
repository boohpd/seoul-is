---
import Base from '../../layouts/Base.astro';
---
<Base title="Payment Successful — seoul.is" description="Thank you for advertising on seoul.is">
  <div style="min-height:80vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:40px var(--page-pad);">
    <div style="max-width:480px;">
      <div style="font-size:4rem;margin-bottom:24px;">🎉</div>
      <h1 style="font-size:2rem;font-weight:900;margin-bottom:12px;">Payment Successful!</h1>
      <p style="color:var(--text-secondary);line-height:1.7;margin-bottom:32px;">Thank you for advertising on seoul.is. We'll reach out to <strong style="color:var(--text)">hello@seoul.is</strong> within 24 hours to set up your listing and QR coupon.</p>
      <a href="/" style="display:inline-block;padding:14px 32px;background:var(--primary);color:white;border-radius:12px;font-weight:700;text-decoration:none;">Back to seoul.is →</a>
    </div>
  </div>
</Base>
