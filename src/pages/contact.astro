---
import Base from '../layouts/Base.astro';
---
<Base title="Contact — seoul.is" description="Get in touch with seoul.is for advertising, partnerships, or general inquiries.">
  <main style="max-width:680px;margin:0 auto;padding:60px 24px;color:var(--text);">
    <h1 style="font-size:2.5rem;font-weight:900;margin-bottom:8px;">Contact <span style="color:var(--primary)">Us</span></h1>
    <p style="color:var(--text-muted);margin-bottom:40px;">We'd love to hear from you.</p>

    <div style="display:grid;gap:20px;">
      <div style="padding:24px;background:rgba(255,255,255,0.03);border-radius:12px;border:1px solid rgba(255,255,255,0.06);">
        <h2 style="font-size:1rem;font-weight:700;margin-bottom:8px;">📢 Advertising & Partnerships</h2>
        <p style="color:var(--text-secondary);line-height:1.7;margin-bottom:12px;">Want to reach thousands of international visitors to Seoul? We offer banner ads, sponsored content, and featured listings.</p>
        <a href="mailto:seoulis.info@gmail.com" style="color:var(--primary);font-weight:700;">seoulis.info@gmail.com</a>
      </div>
      <div style="padding:24px;background:rgba(255,255,255,0.03);border-radius:12px;border:1px solid rgba(255,255,255,0.06);">
        <h2 style="font-size:1rem;font-weight:700;margin-bottom:8px;">📝 Content & Editorial</h2>
        <p style="color:var(--text-secondary);line-height:1.7;margin-bottom:12px;">For content submissions, corrections, or editorial inquiries.</p>
        <a href="mailto:seoulis.info@gmail.com" style="color:var(--primary);font-weight:700;">seoulis.info@gmail.com</a>
      </div>
      <div style="padding:24px;background:rgba(255,255,255,0.03);border-radius:12px;border:1px solid rgba(255,255,255,0.06);">
        <h2 style="font-size:1rem;font-weight:700;margin-bottom:8px;">💬 Community</h2>
        <p style="color:var(--text-secondary);line-height:1.7;margin-bottom:12px;">Join our Telegram community for real-time Seoul updates.</p>
        <a href="https://t.me/SeoulPrimeClub_Chat" target="_blank" style="color:#0088CC;font-weight:700;">@SeoulPrimeClub_Chat</a>
      </div>
    </div>
  </main>
</Base>
