---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const events = [
  { title: 'Seoul Lantern Festival', date: 'Nov 2, 2026', location: 'Cheonggyecheon Stream', category: 'Culture', days: 12, img: 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=600&q=80', link: '#', cta: 'Learn More' },
  { title: 'K-Pop World Festival', date: 'Nov 18, 2026', location: 'Olympic Park, Seoul', category: 'Music', days: 28, img: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=600&q=80', link: '#', cta: 'Get Tickets' },
  { title: 'Busan International Film Festival', date: 'Dec 5, 2026', location: 'Haeundae, Busan', category: 'Culture', days: 45, img: 'https://images.unsplash.com/photo-1440404653325-ab127d49abc1?w=600&q=80', link: '#', cta: 'Learn More' },
  { title: 'Seoul Food & Wine Festival', date: 'Nov 8, 2026', location: 'DDP, Dongdaemun', category: 'Food', days: 18, img: 'https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=600&q=80', link: '#', cta: 'Get Tickets' },
  { title: 'Incheon Pentaport Rock Festival', date: 'Nov 25, 2026', location: 'Incheon', category: 'Music', days: 35, img: 'https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?w=600&q=80', link: '#', cta: 'Get Tickets' },
  { title: 'Seoul Marathon 2026', date: 'Dec 12, 2026', location: 'City Hall, Seoul', category: 'Sports', days: 52, img: 'https://images.unsplash.com/photo-1452626038306-9aae5e071dd3?w=600&q=80', link: '#', cta: 'Learn More' },
  { title: 'Myeongdong Christmas Market', date: 'Dec 1, 2026', location: 'Myeongdong, Seoul', category: 'Culture', days: 41, img: 'https://images.unsplash.com/photo-1512389142860-9c449e58a543?w=600&q=80', link: '#', cta: 'Learn More' },
  { title: 'Busan K-Food Festival', date: 'Nov 14, 2026', location: 'Centum City, Busan', category: 'Food', days: 24, img: 'https://images.unsplash.com/photo-1498654896293-37aacf113fd9?w=600&q=80', link: '#', cta: 'Learn More' },
];

const filters = ['All', 'Music', 'Food', 'Culture', 'Sports'];
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Events in Korea — seoul.is</title>
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <Header />

  <div class="page-hero">
    <h1 class="display">📅 Events in Korea</h1>
    <p>Upcoming festivals, concerts, food fairs, and more.</p>
  </div>

  <section class="section">
    <div class="filter-row">
      {filters.map(f => (
        <button class={`filter-btn ${f === 'All' ? 'active' : ''}`} data-filter={f}>{f}</button>
      ))}
    </div>

    <div class="events-grid" id="events-grid">
      {events.map(ev => (
        <div class="event-card" data-category={ev.category}>
          <div class="event-img-wrap">
            <img src={ev.img} alt={ev.title} loading="lazy" />
            <span class="badge-dday">D-{ev.days}</span>
          </div>
          <div class="event-body">
            <div class="event-meta">
              <span class="event-cat">{ev.category}</span>
              <span class="event-date">📅 {ev.date}</span>
            </div>
            <h3 class="event-title">{ev.title}</h3>
            <p class="event-location">📍 {ev.location}</p>
            <a href={ev.link} class="btn btn-outline" style="margin-top:0.75rem;font-size:0.82rem;">{ev.cta}</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <Footer />

  <style>
    .page-hero {
      background: linear-gradient(135deg, var(--card-bg), var(--bg));
      padding: 3.5rem 1.5rem;
      text-align: center;
      border-bottom: 1px solid var(--border);
    }
    .page-hero h1 { font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 0.75rem; }
    .page-hero p { color: var(--gray); }
    .filter-row { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 2rem; }
    .filter-btn {
      background: var(--card-bg);
      border: 1px solid var(--border);
      color: var(--gray);
      padding: 0.45rem 1.1rem;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 600;
      transition: all 0.2s;
    }
    .filter-btn.active, .filter-btn:hover {
      background: var(--gold);
      color: #000;
      border-color: var(--gold);
    }
    .events-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }
    @media (max-width: 1000px) { .events-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .events-grid { grid-template-columns: 1fr; } }
    .event-card {
      background: var(--card-bg);
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--border);
      transition: border-color 0.2s, transform 0.2s;
    }
    .event-card:hover { border-color: var(--gold); transform: translateY(-2px); }
    .event-card.hidden { display: none; }
    .event-img-wrap { position: relative; }
    .event-img-wrap img { width: 100%; height: 160px; object-fit: cover; }
    .event-img-wrap .badge-dday { position: absolute; top: 10px; right: 10px; }
    .event-body { padding: 1rem 1.25rem 1.25rem; }
    .event-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem; }
    .event-cat {
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      color: var(--gold);
    }
    .event-date { font-size: 0.72rem; color: var(--gray); }
    .event-title { font-size: 0.92rem; font-weight: 800; margin-bottom: 0.3rem; line-height: 1.3; font-family: var(--font-body); }
    .event-location { color: var(--gray); font-size: 0.8rem; }
  </style>

  <script>
    const btns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.event-card');
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.dataset.filter;
        cards.forEach(card => {
          if (filter === 'All' || card.dataset.category === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  </script>
</body>
</html>
